@@ -0,0 +1,190 @@
+import { createFileRoute, Link } from "@tanstack/react-router";
+import {
+  Ban,
+  Building2,
+  ChevronRight,
+  Heart,
+  MessageCircle,
+  Star,
+  Tag,
+  VolumeX,
+  type LucideIcon,
+} from "lucide-react";
+import { useState } from "react";
+import { Avatar } from "@/components/ediraa";
+import { CloseFriendsSheet } from "@/components/close-friends-sheet";
+import { PageHeader, PageShell } from "@/components/page-shell";
+import { SafetyListsSheet } from "@/components/safety-lists-sheet";
+import { useAuth } from "@/lib/auth";
+
+export const Route = createFileRoute("/my-profile")({
+  head: () => ({
+    meta: [
+      { title: "My Profile — SabZone" },
+      { name: "description", content: "Your close friends, blocked and muted accounts and activity." },
+    ],
+  }),
+  component: MyProfilePage,
+});
+
+const rowClass =
+  "flex w-full items-center gap-3 px-4 py-3.5 text-left text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset";
+
+function Row({
+  icon: Icon,
+  label,
+  hint,
+  onClick,
+}: {
+  icon: LucideIcon;
+  label: string;
+  hint?: string;
+  onClick: () => void;
+}) {
+  return (
+    <button type="button" onClick={onClick} className={rowClass}>
+      <Icon className="h-5 w-5 shrink-0" aria-hidden="true" />
+      <span className="min-w-0 flex-1">
+        <span className="block">{label}</span>
+        {hint && <span className="block text-xs text-muted-foreground">{hint}</span>}
+      </span>
+      <ChevronRight className="h-5 w-5 shrink-0 text-muted-foreground" aria-hidden="true" />
+    </button>
+  );
+}
+
+function LinkRow({
+  icon: Icon,
+  label,
+  hint,
+  to,
+  tab,
+}: {
+  icon: LucideIcon;
+  label: string;
+  hint?: string;
+  to: "/my-activity" | "/business";
+  tab?: "comments" | "tags" | "likes";
+}) {
+  const inner = (
+    <>
+      <Icon className="h-5 w-5 shrink-0" aria-hidden="true" />
+      <span className="min-w-0 flex-1">
+        <span className="block">{label}</span>
+        {hint && <span className="block text-xs text-muted-foreground">{hint}</span>}
+      </span>
+      <ChevronRight className="h-5 w-5 shrink-0 text-muted-foreground" aria-hidden="true" />
+    </>
+  );
+  return to === "/my-activity" ? (
+    <Link to="/my-activity" search={{ tab: tab ?? "comments" }} className={rowClass}>
+      {inner}
+    </Link>
+  ) : (
+    <Link to="/business" className={rowClass}>
+      {inner}
+    </Link>
+  );
+}
+
+function Group({ title, children }: { title: string; children: React.ReactNode }) {
+  return (
+    <section className="space-y-1.5">
+      <h2 className="px-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
+        {title}
+      </h2>
+      <div className="glass-card divide-y divide-border">{children}</div>
+    </section>
+  );
+}
+
+function MyProfilePage() {
+  const { profile } = useAuth();
+  const [friendsOpen, setFriendsOpen] = useState(false);
+  const [safety, setSafety] = useState<"blocked" | "muted" | null>(null);
+  const name = profile?.full_name || profile?.username || "";
+
+  return (
+    <PageShell>
+      <PageHeader title="My Profile" />
+      <Link to="/profile" className="glass-card flex items-center gap-3 p-4">
+        <Avatar src={profile?.avatar_url} name={name} size={48} />
+        <div className="min-w-0 flex-1">
+          <p className="truncate font-semibold">{name}</p>
+          <p className="truncate text-sm text-muted-foreground">View your profile</p>
+        </div>
+        <ChevronRight className="h-5 w-5 text-muted-foreground" />
+      </Link>
+
+      <Group title="Who can see your content">
+        <Row
+          icon={Star}
+          label="Close Friends"
+          hint="Choose who sees your Close Friends stories"
+          onClick={() => setFriendsOpen(true)}
+        />
+        <Row
+          icon={Ban}
+          label="Blocked"
+          hint="People you blocked"
+          onClick={() => setSafety("blocked")}
+        />
+      </Group>
+
+      <Group title="What you see">
+        <Row
+          icon={VolumeX}
+          label="Muted"
+          hint="People whose posts you muted"
+          onClick={() => setSafety("muted")}
+        />
+      </Group>
+
+      <Group title="Your activity">
+        <LinkRow
+          icon={MessageCircle}
+          label="Comments"
+          hint="Comments you wrote"
+          to="/my-activity"
+          tab="comments"
+        />
+        <LinkRow
+          icon={Tag}
+          label="Tags"
+          hint="Posts you are tagged in"
+          to="/my-activity"
+          tab="tags"
+        />
+        <LinkRow
+          icon={Heart}
+          label="Likes"
+          hint="Posts you liked"
+          to="/my-activity"
+          tab="likes"
+        />
+      </Group>
+
+      <Group title="Profiles">
+        <LinkRow
+          icon={Building2}
+          label="Add profile"
+          hint="Create a Business Page"
+          to="/business"
+        />
+      </Group>
+
+      {friendsOpen && profile && (
+        <CloseFriendsSheet open onOpenChange={setFriendsOpen} meId={profile.id} />
+      )}
+      {safety && (
+        <SafetyListsSheet
+          open
+          initial={safety}
+          onOpenChange={(open) => {
+            if (!open) setSafety(null);
+          }}
+        />
+      )}
+    </PageShell>
+  );
+}
diff --git a/src/routes/my-activity.tsx b/src/routes/my-activity.tsx
new file mode 100644
index 0000000..49aeb5c
--- /dev/null
+++ b/src/routes/my-activity.tsx
@@ -0,0 +1,191 @@
+import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Loader2, Play, Trash2 } from "lucide-react";
+import { toast } from "sonner";
+import { Pill } from "@/components/ediraa";
+import { PageHeader, PageShell } from "@/components/page-shell";
+import { useAuth } from "@/lib/auth";
+import type { PostRow } from "@/integrations/supabase/types";
+import { userMessage } from "@/lib/security";
+import {
+  deleteComment,
+  fetchLikedPosts,
+  fetchMyComments,
+  fetchTaggedPosts,
+} from "@/lib/social";
+import { timeAgo } from "@/lib/time";
+
+type Tab = "comments" | "tags" | "likes";
+const TABS: { key: Tab; label: string }[] = [
+  { key: "comments", label: "Comments" },
+  { key: "tags", label: "Tags" },
+  { key: "likes", label: "Likes" },
+];
+
+export const Route = createFileRoute("/my-activity")({
+  head: () => ({ meta: [{ title: "Your activity — SabZone" }] }),
+  validateSearch: (search: Record<string, unknown>): { tab: Tab } => ({
+    tab: search["tab"] === "tags" || search["tab"] === "likes" ? search["tab"] : "comments",
+  }),
+  component: MyActivityPage,
+});
+
+function Loading() {
+  return (
+    <div className="grid place-items-center py-10">
+      <Loader2 className="h-6 w-6 animate-spin text-primary" aria-label="Loading" />
+    </div>
+  );
+}
+
+function Empty({ text }: { text: string }) {
+  return <p className="glass-card p-6 text-center text-sm text-muted-foreground">{text}</p>;
+}
+
+function Failed({ text, onRetry }: { text: string; onRetry: () => void }) {
+  return (
+    <div role="alert" className="glass-card space-y-3 p-4 text-center text-sm">
+      <p className="text-muted-foreground">{text}</p>
+      <button
+        type="button"
+        onClick={onRetry}
+        className="rounded-full border border-primary px-4 py-1.5 font-medium text-primary"
+      >
+        Try again
+      </button>
+    </div>
+  );
+}
+
+/** Photos and videos in a 3-column grid; each one opens its post page. */
+function PostGrid({ posts }: { posts: PostRow[] }) {
+  return (
+    <div className="-mx-4 grid grid-cols-3 gap-0.5 bg-card sm:mx-0">
+      {posts.map((p) => {
+        const cover = p.media_type === "video" ? p.thumbnail_url : p.image_url;
+        return (
+          <Link
+            key={p.id}
+            to="/post/$id"
+            params={{ id: p.id }}
+            aria-label={`Open post${p.content ? `: ${p.content.slice(0, 60)}` : ""}`}
+            className="relative block aspect-square w-full overflow-hidden bg-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+          >
+            {cover ? (
+              <img src={cover} alt="" loading="lazy" className="h-full w-full object-cover" />
+            ) : (
+              <p className="line-clamp-5 break-words p-3 text-xs font-medium leading-snug">
+                {p.content}
+              </p>
+            )}
+            {p.media_type === "video" && (
+              <span
+                aria-hidden="true"
+                className="pointer-events-none absolute right-1 top-1 grid h-4 w-4 place-items-center rounded-[5px] bg-white shadow-sm"
+              >
+                <Play className="h-2 w-2 fill-black text-black" />
+              </span>
+            )}
+          </Link>
+        );
+      })}
+    </div>
+  );
+}
+
+function MyComments({ meId }: { meId: string }) {
+  const qc = useQueryClient();
+  const list = useQuery({
+    queryKey: ["my-comments", meId],
+    queryFn: () => fetchMyComments(meId),
+    enabled: !!meId,
+  });
+  const remove = useMutation({
+    mutationFn: (id: string) => deleteComment(id),
+    onSuccess: () => {
+      toast.success("Comment deleted");
+      void qc.invalidateQueries({ queryKey: ["my-comments", meId] });
+    },
+    onError: (e) => toast.error(userMessage(e, "Couldn't delete the comment.")),
+  });
+  if (list.isLoading) return <Loading />;
+  if (list.isError) return <Failed text="Couldn't load your comments." onRetry={() => list.refetch()} />;
+  if (!list.data?.length) return <Empty text="You haven't commented on anything yet." />;
+  return (
+    <ul className="glass-card divide-y divide-border">
+      {list.data.map((c) => (
+        <li key={c.id} className="flex items-start gap-3 px-4 py-3">
+          <Link
+            to="/post/$id"
+            params={{ id: c.post_id }}
+            search={{ comments: true }}
+            className="min-w-0 flex-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+          >
+            <p className="break-words text-sm">{c.content}</p>
+            <p className="mt-0.5 text-xs text-muted-foreground">{timeAgo(c.created_at)}</p>
+          </Link>
+          <button
+            type="button"
+            onClick={() => remove.mutate(c.id)}
+            disabled={remove.isPending}
+            aria-label="Delete comment"
+            className="grid h-9 w-9 shrink-0 place-items-center rounded-full text-muted-foreground hover:bg-card hover:text-destructive disabled:opacity-50"
+          >
+            <Trash2 className="h-4 w-4" />
+          </button>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function PostsTab({ kind, meId }: { kind: "tags" | "likes"; meId: string }) {
+  const list = useQuery({
+    queryKey: [kind === "tags" ? "my-tagged-posts" : "my-liked-posts", meId],
+    queryFn: () => (kind === "tags" ? fetchTaggedPosts(meId) : fetchLikedPosts(meId)),
+    enabled: !!meId,
+  });
+  if (list.isLoading) return <Loading />;
+  if (list.isError)
+    return (
+      <Failed
+        text={kind === "tags" ? "Couldn't load tagged posts." : "Couldn't load liked posts."}
+        onRetry={() => list.refetch()}
+      />
+    );
+  if (!list.data?.length)
+    return (
+      <Empty
+        text={
+          kind === "tags"
+            ? "No posts you're tagged in yet."
+            : "No likes yet. Posts you like will show up here."
+        }
+      />
+    );
+  return <PostGrid posts={list.data} />;
+}
+
+function MyActivityPage() {
+  const { tab } = Route.useSearch();
+  const navigate = useNavigate();
+  const { user } = useAuth();
+  const meId = user?.id ?? "";
+  return (
+    <PageShell>
+      <PageHeader title="Your activity" smartBack />
+      <div role="tablist" aria-label="Activity" className="flex gap-2">
+        {TABS.map((t) => (
+          <Pill
+            key={t.key}
+            active={tab === t.key}
+            onClick={() => void navigate({ to: "/my-activity", search: { tab: t.key }, replace: true })}
+          >
+            {t.label}
+          </Pill>
+        ))}
+      </div>
+      {tab === "comments" ? <MyComments meId={meId} /> : <PostsTab kind={tab} meId={meId} />}
+    </PageShell>
+  );
+}
