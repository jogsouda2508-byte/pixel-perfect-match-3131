diff --git a/src/lib/native-auth-callback.ts b/src/lib/native-auth-callback.ts
new file mode 100644
index 0000000..8cf449b
--- /dev/null
+++ b/src/lib/native-auth-callback.ts
@@ -0,0 +1,62 @@
+import {
+  NATIVE_AUTH_REDIRECT,
+  NATIVE_RESET_REDIRECT,
+  type NativeAuthKind,
+} from "@/lib/auth-redirect";
+
+export {
+  PENDING_TTL_MS,
+  consumeNativeAuthPending,
+  markNativeAuthPending,
+  type NativeAuthKind,
+} from "@/lib/auth-redirect";
+
+/**
+ * The Android app is opened by `sabzone://auth-callback#access_token=...` (Google sign-in) and
+ * `sabzone://reset-password#...` (password-reset email). ANY web page or app can fire such a link,
+ * so without checks an attacker could push THEIR session into the victim's app (login CSRF /
+ * session fixation) and then read whatever the victim uploads.
+ *
+ * Two defences, both here and both unit-tested (src/test/security-native-auth.test.ts):
+ *   1. parseNativeAuthUrl: strict parsing, exact scheme + host, credentials in a safe format.
+ *   2. a short-lived "pending" flag that only the app itself sets when IT starts Google sign-in or a
+ *      password reset. A callback is accepted once, and only while the flag is fresh.
+ */
+
+export type NativeAuthLink =
+  | { kind: NativeAuthKind; accessToken: string; refreshToken: string; code?: undefined }
+  | { kind: NativeAuthKind; code: string; accessToken?: undefined; refreshToken?: undefined };
+
+const MAX_LINK_LENGTH = 4096;
+const TOKEN_RE = /^[A-Za-z0-9._-]{10,3000}$/;
+const CODE_RE = /^[A-Za-z0-9._~-]{6,512}$/;
+
+export function parseNativeAuthUrl(url: unknown): NativeAuthLink | null {
+  if (typeof url !== "string" || url.length === 0 || url.length > MAX_LINK_LENGTH) return null;
+  const base = [
+    { prefix: NATIVE_AUTH_REDIRECT, kind: "auth" as const },
+    { prefix: NATIVE_RESET_REDIRECT, kind: "reset" as const },
+  ].find((b) => url.startsWith(b.prefix));
+  if (!base) return null;
+  // the character after the prefix must end the host: "sabzone://auth-callback.evil" is not ours
+  const next = url.charAt(base.prefix.length);
+  if (next !== "" && next !== "/" && next !== "?" && next !== "#") return null;
+
+  const rest = url.slice(base.prefix.length);
+  const hashAt = rest.indexOf("#");
+  const beforeHash = hashAt === -1 ? rest : rest.slice(0, hashAt);
+  const fragment = hashAt === -1 ? "" : rest.slice(hashAt + 1);
+  const queryAt = beforeHash.indexOf("?");
+  const query = queryAt === -1 ? "" : beforeHash.slice(queryAt + 1);
+
+  const params = new URLSearchParams(fragment || query);
+  const queryParams = new URLSearchParams(query);
+  const access = params.get("access_token");
+  const refresh = params.get("refresh_token");
+  if (access && refresh && TOKEN_RE.test(access) && TOKEN_RE.test(refresh)) {
+    return { kind: base.kind, accessToken: access, refreshToken: refresh };
+  }
+  const code = queryParams.get("code") ?? params.get("code");
+  if (code && CODE_RE.test(code)) return { kind: base.kind, code };
+  return null;
+}
diff --git a/src/lib/security-headers.ts b/src/lib/security-headers.ts
new file mode 100644
index 0000000..1429cf8
--- /dev/null
+++ b/src/lib/security-headers.ts
@@ -0,0 +1,93 @@
+/**
+ * HTTP security headers for the server entry (src/server.ts).
+ *
+ *  - Low-risk headers are ALWAYS sent (nosniff, referrer policy, permissions policy, HSTS on https).
+ *  - The Content-Security-Policy is sent as `Content-Security-Policy-Report-Only` by default, so a
+ *    mistake can only produce console reports, never a broken page. Set CSP_ENFORCE=1 on the server
+ *    once the reports are clean (docs/SECURITY-UI.md, "Rolling out the CSP").
+ *
+ * Pure functions, unit-tested in src/test/security-headers.test.ts.
+ */
+
+export type HeaderOptions = {
+  /** e.g. https://abcd.supabase.co (VITE_SUPABASE_URL). */
+  supabaseUrl?: string | undefined;
+  /** true -> send an enforced Content-Security-Policy instead of Report-Only. */
+  enforceCsp?: boolean | undefined;
+  /** true when the request arrived over https (adds HSTS). */
+  https?: boolean | undefined;
+};
+
+function originOf(url: string | undefined): { http: string; ws: string } | null {
+  if (!url) return null;
+  try {
+    const u = new URL(url);
+    if (u.protocol !== "https:" && u.protocol !== "http:") return null;
+    return { http: u.origin, ws: `${u.protocol === "https:" ? "wss:" : "ws:"}//${u.host}` };
+  } catch {
+    return null;
+  }
+}
+
+/** Third parties this app talks to on purpose (GIFs, music search, place search, fonts, Google avatars). */
+const IMG_HOSTS = [
+  "https://*.giphy.com",
+  "https://*.googleusercontent.com",
+  "https://*.mzstatic.com",
+];
+const MEDIA_HOSTS = ["https://*.mzstatic.com", "https://*.itunes.apple.com", "https://*.giphy.com"];
+const CONNECT_HOSTS = [
+  "https://api.giphy.com",
+  "https://itunes.apple.com",
+  "https://photon.komoot.io",
+];
+
+export function buildCsp(opts: Pick<HeaderOptions, "supabaseUrl"> = {}): string {
+  const sb = originOf(opts.supabaseUrl);
+  const sbHttp = sb ? [sb.http] : [];
+  const sbWs = sb ? [sb.ws] : [];
+  const directives: Array<[string, string[]]> = [
+    ["default-src", ["'self'"]],
+    // TanStack Start inlines its hydration script, so 'unsafe-inline' stays until nonces are added.
+    // Remote script hosts are still blocked, which is what stops injected <script src=...>.
+    ["script-src", ["'self'", "'unsafe-inline'"]],
+    ["style-src", ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"]],
+    ["font-src", ["'self'", "data:", "https://fonts.gstatic.com"]],
+    ["img-src", ["'self'", "data:", "blob:", ...sbHttp, ...IMG_HOSTS]],
+    ["media-src", ["'self'", "blob:", "data:", ...sbHttp, ...MEDIA_HOSTS]],
+    ["connect-src", ["'self'", ...sbHttp, ...sbWs, ...CONNECT_HOSTS]],
+    ["worker-src", ["'self'", "blob:"]],
+    ["manifest-src", ["'self'"]],
+    ["frame-src", ["'none'"]],
+    ["object-src", ["'none'"]],
+    ["base-uri", ["'self'"]],
+    ["form-action", ["'self'"]],
+    ["frame-ancestors", ["'self'"]],
+  ];
+  return directives.map(([name, values]) => `${name} ${values.join(" ")}`).join("; ");
+}
+
+export function securityHeaders(opts: HeaderOptions = {}): Record<string, string> {
+  const headers: Record<string, string> = {
+    "x-content-type-options": "nosniff",
+    "referrer-policy": "strict-origin-when-cross-origin",
+    // the app needs the camera, microphone and location itself; nothing else, and no payments
+    "permissions-policy": "camera=(self), microphone=(self), geolocation=(self), payment=()",
+  };
+  if (opts.https) headers["strict-transport-security"] = "max-age=31536000; includeSubDomains";
+  headers[opts.enforceCsp ? "content-security-policy" : "content-security-policy-report-only"] =
+    buildCsp(opts);
+  return headers;
+}
+
+/** Copies `response` and adds each header that the response does not already set. */
+export function withSecurityHeaders(response: Response, extra: Record<string, string>): Response {
+  const headers = new Headers(response.headers);
+  for (const [name, value] of Object.entries(extra))
+    if (!headers.has(name)) headers.set(name, value);
+  return new Response(response.body, {
+    status: response.status,
+    statusText: response.statusText,
+    headers,
+  });
+}
diff --git a/src/lib/security.ts b/src/lib/security.ts
new file mode 100644
index 0000000..cf34483
--- /dev/null
+++ b/src/lib/security.ts
@@ -0,0 +1,99 @@
+/**
+ * Small, dependency-free helpers for rendering untrusted data safely.
+ * Everything here is pure so it can be unit-tested (src/test/security-lib.test.ts).
+ * See docs/SECURITY-UI.md.
+ */
+
+/** Escapes text for use inside XML / SVG (element text AND attribute values). */
+export function escapeXml(text: string): string {
+  return text
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&apos;");
+}
+
+/** #rgb, #rgba, #rrggbb or #rrggbbaa. Used before a colour goes into an SVG attribute. */
+export function isHexColor(value: unknown): value is string {
+  return typeof value === "string" && /^#(?:[0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(value);
+}
+
+const MAX_URL_LENGTH = 2048;
+// control characters, spaces and backslashes are exactly what must not appear in a URL we trust
+// eslint-disable-next-line no-control-regex
+const HAS_UNSAFE_CHAR = /[\u0000-\u0020\u007f-\u009f\\]/;
+
+function parseHttpUrl(raw: unknown): URL | null {
+  if (typeof raw !== "string") return null;
+  const v = raw.trim();
+  if (v.length === 0 || v.length > MAX_URL_LENGTH || HAS_UNSAFE_CHAR.test(v)) return null;
+  let u: URL;
+  try {
+    u = new URL(v);
+  } catch {
+    return null;
+  }
+  if (u.protocol === "https:") return u;
+  // plain http only for local development
+  if (u.protocol === "http:" && (u.hostname === "localhost" || u.hostname === "127.0.0.1"))
+    return u;
+  return null;
+}
+
+/**
+ * A URL that is safe to put in `<a href>`: https only (http only for localhost). Anything else
+ * (`javascript:`, `data:`, `vbscript:`, `file:`, `intent:`, relative or malformed values) -> null.
+ */
+export function safeLinkUrl(raw: unknown): string | null {
+  const u = parseHttpUrl(raw);
+  return u ? (raw as string).trim() : null;
+}
+
+const DATA_IMAGE = /^data:image\/(?:png|jpe?g|webp|gif|avif);base64,[a-z0-9+/=]+$/i;
+
+/**
+ * A URL that is safe to put in `<img src>` / `<video src>`: everything `safeLinkUrl` allows,
+ * plus this app's own paths ("/assets/x.png"), `blob:` previews made in this browser, and
+ * base64 raster images. SVG data URLs are refused.
+ */
+export function safeMediaUrl(raw: unknown): string | null {
+  if (typeof raw !== "string") return null;
+  const v = raw.trim();
+  if (v.length === 0) return null;
+  if (v.startsWith("blob:"))
+    return v.length <= MAX_URL_LENGTH && !HAS_UNSAFE_CHAR.test(v) ? v : null;
+  if (v.startsWith("data:")) return v.length <= 2_000_000 && DATA_IMAGE.test(v) ? v : null;
+  if (v.startsWith("/") && !v.startsWith("//")) return HAS_UNSAFE_CHAR.test(v) ? null : v;
+  return safeLinkUrl(v);
+}
+
+// Browsers word a failed request differently: "Failed to fetch" (Chrome), "Load failed" (Safari),
+// "NetworkError when attempting to fetch resource" (Firefox). \b keeps "Video upload failed" out.
+const NETWORK_ERROR =
+  /\bfailed to fetch\b|\bnetworkerror\b|\bnetwork request failed\b|\bload failed\b|\btimed out\b|\btimeout\b/i;
+// Words that only appear in database / framework internals, never in a sentence written for people.
+const INTERNAL_DETAIL =
+  /violates|constraint|relation "|column "|duplicate key|syntax error|permission denied|row-level security|\bpolicy\b|\bschema\b|function public\.|pgrst|\bjwt\b|sqlstate|\bstack\b|\bat \S+ \(|typeerror|referenceerror|\bundefined\b|\bnull value\b|\[object /i;
+
+/**
+ * Turns anything that was thrown into text that is safe to show in a toast.
+ *
+ * Messages we wrote on purpose are kept ("Your note is too long", from a `raise exception` or a
+ * `new Error("Choose a photo")`). Raw database / network / framework errors are replaced by
+ * `fallback`, because they reveal table, column and constraint names.
+ */
+export function userMessage(error: unknown, fallback: string): string {
+  if (typeof error !== "object" || error === null) return fallback;
+  const message = (error as { message?: unknown }).message;
+  if (typeof message !== "string") return fallback;
+  const msg = message.trim();
+  if (!msg) return fallback;
+  if (NETWORK_ERROR.test(msg)) return "Network error. Check your connection and try again.";
+  if (msg.length > 200 || /[\r\n]/.test(msg)) return fallback;
+  // Database errors carry a SQLSTATE `code`. Only P0001 (`raise exception 'text'`) is written for people.
+  const code = (error as { code?: unknown }).code;
+  if (typeof code === "string" && code !== "P0001") return fallback;
+  if (INTERNAL_DETAIL.test(msg)) return fallback;
+  return msg;
+}
