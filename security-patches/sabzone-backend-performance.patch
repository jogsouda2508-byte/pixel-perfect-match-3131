diff --git a/supabase/functions/send-push/logic.ts b/supabase/functions/send-push/logic.ts
index d9ed1fc..8ccea04 100644
--- a/supabase/functions/send-push/logic.ts
+++ b/supabase/functions/send-push/logic.ts
@@ -87,3 +87,64 @@ export function safeEqual(a: string, b: string): boolean {
   for (let i = 0; i < len; i++) diff |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0);
   return diff === 0;
 }
+
+// ---- speed and observability helpers ---------------------------------------------------------
+
+/** At most this many pushes are in flight at once (one request can name 500 people). */
+export const MAX_CONCURRENT_DELIVERIES = 25;
+/** A push service or Google that has not answered after this long is counted as failed. */
+export const DELIVERY_TIMEOUT_MS = 10_000;
+/** A real request is a few hundred bytes; 500 UUIDs fit well under this. */
+export const MAX_BODY_BYTES = 64 * 1024;
+
+/** True when the Content-Length header announces a body that is too large to accept. */
+export function isBodyTooLarge(contentLength: string | null): boolean {
+  if (contentLength === null) return false;
+  const n = Number(contentLength);
+  return Number.isFinite(n) && n > MAX_BODY_BYTES;
+}
+
+/**
+ * Like Promise.all(items.map(fn)) but with at most `limit` calls running at the same time.
+ * Results keep the order of `items`.
+ */
+export async function mapWithConcurrency<T, R>(
+  items: readonly T[],
+  limit: number,
+  fn: (item: T, index: number) => Promise<R>,
+): Promise<R[]> {
+  const results = new Array<R>(items.length);
+  let next = 0;
+  const worker = async (): Promise<void> => {
+    for (;;) {
+      const i = next++;
+      if (i >= items.length) return;
+      results[i] = await fn(items[i] as T, i);
+    }
+  };
+  const workers = Math.max(1, Math.min(Math.floor(limit) || 1, items.length));
+  await Promise.all(Array.from({ length: workers }, worker));
+  return results;
+}
+
+export type DeliveryCounts = { sent: number; removed: number; failed: number };
+
+/**
+ * One structured log line for a finished request: how long it took and how many pushes went
+ * where. Numbers only: no people, endpoints, tokens or message text can end up in the log.
+ */
+export function pushSummaryLog(fields: {
+  ms: number;
+  recipients: number;
+  web: DeliveryCounts;
+  android: DeliveryCounts;
+}): string {
+  const counts = (c: DeliveryCounts) => ({ sent: c.sent, removed: c.removed, failed: c.failed });
+  return JSON.stringify({
+    event: "send_push_done",
+    ms: Math.round(fields.ms),
+    recipients: fields.recipients,
+    web: counts(fields.web),
+    android: counts(fields.android),
+  });
+}
diff --git a/supabase/migrations/20261117000000_backend_performance.sql b/supabase/migrations/20261117000000_backend_performance.sql
new file mode 100644
index 0000000..f965947
--- /dev/null
+++ b/supabase/migrations/20261117000000_backend_performance.sql
@@ -0,0 +1,103 @@
+-- =====================================================================
+-- Backend performance: missing foreign-key indexes + a cheaper unread-notification count.
+-- Safe to run more than once. Changes no data, no permission and no row-level-security rule.
+-- Run in Supabase Dashboard -> SQL Editor (or `supabase db push`). Details and rollback:
+-- docs/BACKEND-PERFORMANCE.md
+--
+-- 1. FOREIGN-KEY INDEXES. When a person is deleted, Postgres must find every row that points at
+--    them in every child table. Where the pointing column had no index of its own that was a full
+--    table scan per table (messages, post_comments, ...), so deleting one account got slower as
+--    the app grew. The same indexes speed up "all rows by this person" reads and joins.
+--    (Composite primary keys only help when the person column comes FIRST; the columns below were
+--    second or not in a key at all. src/test/migration-perf.test.ts keeps it that way.)
+-- 2. get_unread_notification_count() used to build the whole notification list (up to 100 rows,
+--    sorted, joined to profiles, including a scan of every chat message that shared a post) just
+--    to count it, and the home screen asks every 30 seconds. It now counts each kind directly.
+--    Same rules as before: the same seven kinds, "shares" never count, only things newer than
+--    profiles.notifications_seen_at, capped at 100 like the old list.
+-- =====================================================================
+
+-- ---- 1. foreign-key indexes -----------------------------------------
+create index if not exists business_reviews_reviewer_id_idx        on public.business_reviews (reviewer_id);
+create index if not exists community_alert_votes_user_id_idx       on public.community_alert_votes (user_id);
+create index if not exists community_alerts_author_id_idx          on public.community_alerts (author_id);
+create index if not exists community_answer_helpful_user_id_idx    on public.community_answer_helpful (user_id);
+create index if not exists community_answers_author_id_idx         on public.community_answers (author_id);
+create index if not exists community_event_rsvps_user_id_idx       on public.community_event_rsvps (user_id);
+create index if not exists community_events_host_id_idx            on public.community_events (host_id);
+create index if not exists community_poll_options_poll_id_idx      on public.community_poll_options (poll_id);
+create index if not exists community_poll_votes_user_id_idx        on public.community_poll_votes (user_id);
+create index if not exists community_poll_votes_option_id_idx      on public.community_poll_votes (option_id);
+create index if not exists community_polls_author_id_idx           on public.community_polls (author_id);
+create index if not exists community_questions_author_id_idx       on public.community_questions (author_id);
+create index if not exists community_quiz_keys_option_id_idx       on public.community_quiz_keys (option_id);
+create index if not exists community_skill_swaps_user_id_idx       on public.community_skill_swaps (user_id);
+create index if not exists group_invites_invited_by_idx            on public.group_invites (invited_by);
+create index if not exists groups_created_by_idx                   on public.groups (created_by);
+create index if not exists message_reactions_user_id_idx           on public.message_reactions (user_id);
+create index if not exists messages_sender_id_idx                  on public.messages (sender_id);
+create index if not exists poll_votes_user_id_idx                  on public.poll_votes (user_id);
+create index if not exists polls_created_by_idx                    on public.polls (created_by);
+create index if not exists post_comments_author_id_idx             on public.post_comments (author_id);
+create index if not exists post_tags_tagged_by_idx                 on public.post_tags (tagged_by);
+create index if not exists post_video_views_viewer_id_idx          on public.post_video_views (viewer_id);
+create index if not exists saved_posts_post_id_idx                 on public.saved_posts (post_id);
+create index if not exists story_views_viewer_id_idx               on public.story_views (viewer_id);
+-- ON DELETE SET NULL (not cascade): the report stays, the person is cleared. Most rows are null.
+create index if not exists reports_target_user_id_idx
+  on public.reports (target_user_id) where target_user_id is not null;
+
+-- ---- 2. cheaper unread-notification count ---------------------------
+create or replace function public.get_unread_notification_count()
+returns bigint
+language sql
+stable
+set search_path = public
+as $$
+  with me as (
+    select pr.id as uid, pr.notifications_seen_at as seen
+    from public.profiles pr
+    where pr.id = auth.uid()
+  )
+  select least(100, (
+      -- likes on my posts
+      (select count(*) from me
+         join public.posts p on p.author_id = me.uid
+         join public.post_likes l on l.post_id = p.id
+        where l.user_id <> me.uid and l.created_at > me.seen)
+      -- comments on my posts
+    + (select count(*) from me
+         join public.posts p on p.author_id = me.uid
+         join public.post_comments c on c.post_id = p.id
+        where c.author_id <> me.uid and c.created_at > me.seen)
+      -- new followers
+    + (select count(*) from me
+         join public.follows f on f.following_id = me.uid
+        where f.created_at > me.seen)
+      -- tagged in a post
+    + (select count(*) from me
+         join public.post_tags t on t.tagged_user_id = me.uid
+         join public.posts tp on tp.id = t.post_id
+        where t.tagged_by <> me.uid and t.created_at > me.seen)
+      -- likes on my stories
+    + (select count(*) from me
+         join public.stories st on st.author_id = me.uid
+         join public.story_views v on v.story_id = st.id
+        where v.viewer_id <> me.uid and v.liked
+          and v.first_liked_at is not null and v.first_liked_at > me.seen)
+      -- follow requests waiting for me
+    + (select count(*) from me
+         join public.follow_requests fr on fr.target_id = me.uid
+        where fr.status = 'pending' and fr.created_at > me.seen)
+      -- accounts I asked to follow that accepted me (while I still follow them)
+    + (select count(*) from me
+         join public.follow_requests fr on fr.requester_id = me.uid
+        where fr.status = 'accepted'
+          and coalesce(fr.responded_at, fr.created_at) > me.seen
+          and exists (select 1 from public.follows f
+                      where f.follower_id = me.uid and f.following_id = fr.target_id))
+  ))::bigint;
+$$;
+
+revoke all on function public.get_unread_notification_count() from public, anon;
+grant execute on function public.get_unread_notification_count() to authenticated;
diff --git a/supabase/migrations/20261117000001_rls_initplan.sql b/supabase/migrations/20261117000001_rls_initplan.sql
new file mode 100644
index 0000000..230cb46
--- /dev/null
+++ b/supabase/migrations/20261117000001_rls_initplan.sql
@@ -0,0 +1,79 @@
+-- =====================================================================
+-- Row-level-security speed-up: evaluate auth.uid() once per query, not once per row.
+-- Safe to run more than once. Changes WHO can see or do WHAT: nothing.
+-- Run in Supabase Dashboard -> SQL Editor (or `supabase db push`). Details and rollback:
+-- docs/BACKEND-PERFORMANCE.md
+--
+-- Every policy in this app wrote `auth.uid()` directly. Postgres then calls that function again
+-- for every row it checks. Written as `(select auth.uid())` it is evaluated once per query (an
+-- "InitPlan") and the planner can use the value like a constant, which matters most on the big
+-- tables: posts, messages, post_likes, post_comments, follows, stories.
+-- Supabase documents this as the standard fix: https://supabase.com/docs/guides/database/postgres/row-level-security#call-functions-with-select
+--
+-- How it is done: instead of re-typing 120 policies (and drifting from what the earlier
+-- migrations really left behind), this reads the policies that exist, replaces each bare
+-- auth.uid() with (select auth.uid()) and re-applies them with ALTER POLICY. The command, the
+-- roles and the permissive/restrictive kind are never touched. Before it finishes it checks that
+-- the number of policies and each policy's name, command, roles and kind are exactly what they
+-- were; if not, it raises an error and the whole migration is rolled back.
+-- New policies written after this one should use (select auth.uid()) too; the replay test
+-- supabase/tests/replay/performance.assert.sql fails on a bare one.
+-- =====================================================================
+
+do $$
+declare
+  -- an auth.uid() that is not already directly after "select " (so a second run does nothing)
+  pat     constant text := '(?<!select )auth\.uid\(\)';
+  pol     record;
+  v_using text;
+  v_check text;
+  v_done  int := 0;
+  v_skip  int := 0;
+  v_before text;
+  v_after  text;
+begin
+  select md5(coalesce(string_agg(
+           concat_ws('|', schemaname, tablename, policyname, cmd, permissive, roles::text),
+           ',' order by schemaname, tablename, policyname), ''))
+    into v_before
+  from pg_policies where schemaname in ('public', 'storage');
+
+  for pol in
+    select schemaname, tablename, policyname, qual, with_check
+    from pg_policies
+    where schemaname in ('public', 'storage')
+      and (coalesce(qual, '') ~* pat or coalesce(with_check, '') ~* pat)
+    order by schemaname, tablename, policyname
+  loop
+    v_using := case when pol.qual is null then null
+                    else regexp_replace(pol.qual, pat, '(select auth.uid())', 'gi') end;
+    v_check := case when pol.with_check is null then null
+                    else regexp_replace(pol.with_check, pat, '(select auth.uid())', 'gi') end;
+    begin
+      execute format(
+        'alter policy %I on %I.%I%s%s',
+        pol.policyname, pol.schemaname, pol.tablename,
+        case when v_using is null then '' else ' using (' || v_using || ')' end,
+        case when v_check is null then '' else ' with check (' || v_check || ')' end
+      );
+      v_done := v_done + 1;
+    exception when insufficient_privilege then
+      -- e.g. a policy on a table this role does not own: leave it as it was
+      v_skip := v_skip + 1;
+      raise notice 'left unchanged (not the owner): %.% / %',
+        pol.schemaname, pol.tablename, pol.policyname;
+    end;
+  end loop;
+
+  select md5(coalesce(string_agg(
+           concat_ws('|', schemaname, tablename, policyname, cmd, permissive, roles::text),
+           ',' order by schemaname, tablename, policyname), ''))
+    into v_after
+  from pg_policies where schemaname in ('public', 'storage');
+
+  if v_before is distinct from v_after then
+    raise exception 'rls_initplan: the set of policies changed (%, %); rolled back', v_before, v_after;
+  end if;
+
+  raise notice 'rls_initplan: % policies rewritten, % left unchanged', v_done, v_skip;
+end $$;
diff --git a/supabase/tests/replay/performance.assert.sql b/supabase/tests/replay/performance.assert.sql
new file mode 100644
index 0000000..c6a58f5
--- /dev/null
+++ b/supabase/tests/replay/performance.assert.sql
@@ -0,0 +1,99 @@
+-- Performance guards, enforced with ASSERT. Runs inside one transaction and rolls back.
+-- Covers 20261117000000_backend_performance.sql and 20261117000001_rls_initplan.sql.
+begin;
+
+-- ---- 1. No policy still calls auth.uid() once per row.
+do $$
+declare bad text;
+begin
+  select string_agg(format('%s.%s / %s', schemaname, tablename, policyname), ', ') into bad
+  from pg_policies
+  where schemaname in ('public', 'storage')
+    and (coalesce(qual, '') ~* '(?<!select )auth\.uid\(\)'
+         or coalesce(with_check, '') ~* '(?<!select )auth\.uid\(\)');
+  assert bad is null, 'policies with a bare auth.uid() (use (select auth.uid())): ' || coalesce(bad, '');
+end $$;
+
+-- ---- 2. Every foreign key has an index that starts with its column (delete + join speed).
+do $$
+declare bad text;
+begin
+  select string_agg(format('%s(%s)', c.conrelid::regclass, a.attname), ', ') into bad
+  from pg_constraint c
+  join pg_attribute a on a.attrelid = c.conrelid and a.attnum = c.conkey[1]
+  where c.contype = 'f'
+    and c.connamespace = 'public'::regnamespace
+    and not exists (
+      select 1 from pg_index i
+      where i.indrelid = c.conrelid and i.indkey[0] = c.conkey[1] and i.indisvalid
+    );
+  assert bad is null, 'foreign keys without a leading index: ' || coalesce(bad, '');
+end $$;
+
+-- ---- 3. The cheaper unread count gives the same answer as the old way
+--         (the notification list, shares left out, newer than "seen").
+insert into auth.users (id, email, raw_user_meta_data) values
+  ('00000000-0000-0000-0000-00000000000a', 'a@test.local', '{"username":"asha","full_name":"Asha"}'),
+  ('00000000-0000-0000-0000-00000000000b', 'b@test.local', '{"username":"ravi","full_name":"Ravi"}'),
+  ('00000000-0000-0000-0000-00000000000c', 'c@test.local', '{"username":"meena","full_name":"Meena"}'),
+  ('00000000-0000-0000-0000-00000000000d', 'd@test.local', '{"username":"zedd","full_name":"Zed"}');
+
+update public.profiles set notifications_seen_at = now() - interval '1 day'
+  where username = 'asha';
+
+insert into public.posts (id, author_id, content) values
+  ('40000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000a', 'hello');
+insert into public.post_likes (post_id, user_id, created_at) values
+  ('40000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000b', now()),
+  ('40000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000a', now()),                       -- my own like: no
+  ('40000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000c', now() - interval '2 days');   -- before "seen": no
+insert into public.post_comments (post_id, author_id, content) values
+  ('40000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000c', 'nice');
+insert into public.follows (follower_id, following_id) values
+  ('00000000-0000-0000-0000-00000000000b', '00000000-0000-0000-0000-00000000000a'),
+  ('00000000-0000-0000-0000-00000000000a', '00000000-0000-0000-0000-00000000000d');
+insert into public.follow_requests (requester_id, target_id, status) values
+  ('00000000-0000-0000-0000-00000000000c', '00000000-0000-0000-0000-00000000000a', 'pending');
+insert into public.follow_requests (requester_id, target_id, status, responded_at) values
+  ('00000000-0000-0000-0000-00000000000a', '00000000-0000-0000-0000-00000000000d', 'accepted', now());
+-- a shared post in chat: shows in the list, never in the count
+insert into public.conversations (id) values ('50000000-0000-0000-0000-000000000001');
+insert into public.conversation_participants (conversation_id, user_id) values
+  ('50000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000a'),
+  ('50000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000b');
+insert into public.messages (conversation_id, sender_id, body, shared_post_id) values
+  ('50000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000b', '',
+   '40000000-0000-0000-0000-000000000001');
+
+select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-00000000000a', true);
+set local role authenticated;
+do $$
+declare v_new bigint; v_old bigint;
+begin
+  v_new := public.get_unread_notification_count();
+  select count(*) into v_old
+  from public.get_notifications(200) n
+  where n.kind <> 'share'
+    and n.created_at > (select pr.notifications_seen_at from public.profiles pr where pr.id = auth.uid());
+  assert v_new > 0, 'the seeded notifications should be counted';
+  assert v_new = v_old, format('unread count changed: new %s, old way %s', v_new, v_old);
+end $$;
+reset role;
+
+-- nothing is newer than "seen" -> zero, both ways
+update public.profiles set notifications_seen_at = now() + interval '1 hour' where username = 'asha';
+set local role authenticated;
+do $$ begin
+  assert public.get_unread_notification_count() = 0, 'nothing newer than seen -> 0';
+end $$;
+reset role;
+
+-- ---- 4. Still closed to the public key.
+set local role anon;
+do $$ begin
+  perform public.get_unread_notification_count();
+  raise exception 'anon can call get_unread_notification_count';
+exception when insufficient_privilege then null; end $$;
+reset role;
+
+rollback;
