+import { act, renderHook, waitFor } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const { auth, rpc, loginWithUsername } = vi.hoisted(() => ({
+  auth: {
+    getSession: vi.fn(),
+    onAuthStateChange: vi.fn(),
+    signInWithPassword: vi.fn(),
+    signUp: vi.fn(),
+    signOut: vi.fn(),
+    signInWithOAuth: vi.fn(),
+  },
+  rpc: vi.fn(),
+  loginWithUsername: vi.fn(),
+}));
+
+vi.mock("@/integrations/supabase/client", () => ({
+  isSupabaseConfigured: true,
+  supabase: {
+    auth,
+    rpc,
+    from: () => ({ select: () => ({ eq: () => ({ maybeSingle: vi.fn() }) }) }),
+  },
+}));
+vi.mock("@/lib/auth-lookup", () => ({ loginWithUsername }));
+
+import { AuthProvider, useAuth } from "@/lib/auth";
+
+const wrapper = ({ children }: { children: ReactNode }) => <AuthProvider>{children}</AuthProvider>;
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  auth.getSession.mockResolvedValue({ data: { session: null } });
+  auth.onAuthStateChange.mockReturnValue({ data: { subscription: { unsubscribe: () => {} } } });
+  rpc.mockResolvedValue({ data: null, error: null });
+});
+
+async function signIn(identifier: string, password = "pw") {
+  const hook = renderHook(() => useAuth(), { wrapper });
+  await waitFor(() => expect(hook.result.current.loading).toBe(false));
+  let res!: Awaited<ReturnType<typeof hook.result.current.signIn>>;
+  await act(async () => {
+    res = await hook.result.current.signIn(identifier, password);
+  });
+  return res;
+}
+
+describe("signIn through the auth-lookup edge function", () => {
+  it("success: logs in without ever asking the database for an email", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "ok" });
+    expect(await signIn("@Alice")).toEqual({ error: null });
+    expect(loginWithUsername).toHaveBeenCalledWith("alice", "pw");
+    expect(rpc).not.toHaveBeenCalled();
+    expect(auth.signInWithPassword).not.toHaveBeenCalled();
+  });
+
+  it("wrong password or unknown name: the same generic message", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "invalid" });
+    expect(await signIn("alice")).toEqual({ error: "Incorrect username or password." });
+    expect(rpc).not.toHaveBeenCalled();
+  });
+
+  it("unverified account: asks to verify and passes the email on for the resend screen", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "unverified", email: "a@x.com" });
+    const res = await signIn("alice");
+    expect(res.verifyEmail).toBe("a@x.com");
+    expect(res.error).toMatch(/verify your email/i);
+  });
+
+  it("rate limited: says to wait", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "limited" });
+    expect((await signIn("alice")).error).toMatch(/too many attempts/i);
+    expect(rpc).not.toHaveBeenCalled();
+  });
+
+  it("server trouble is reported, and does NOT fall back to the email-leaking database function", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "error" });
+    expect((await signIn("alice")).error).toMatch(/couldn't log you in/i);
+    expect(rpc).not.toHaveBeenCalled();
+    expect(auth.signInWithPassword).not.toHaveBeenCalled();
+  });
+
+  it("emails are still refused before any request is made", async () => {
+    expect((await signIn("a@x.com")).error).toMatch(/username, not your email/i);
+    expect(loginWithUsername).not.toHaveBeenCalled();
+    expect(rpc).not.toHaveBeenCalled();
+  });
+
+  it("ONLY when the function is not deployed (404) does it use the legacy lookup", async () => {
+    loginWithUsername.mockResolvedValue({ kind: "unavailable" });
+    rpc.mockResolvedValue({ data: "alice@x.com", error: null });
+    auth.signInWithPassword.mockResolvedValue({ error: null });
+    expect(await signIn("alice")).toEqual({ error: null });
+    expect(rpc).toHaveBeenCalledWith("get_login_email", { p_username: "alice" });
+    expect(auth.signInWithPassword).toHaveBeenCalledWith({ email: "alice@x.com", password: "pw" });
+  });
+});
