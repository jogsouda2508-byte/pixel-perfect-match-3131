+--- /dev/null
++++ b/supabase/functions/auth-lookup/index.ts
+@@ -0,0 +1,134 @@
++// Supabase Edge Function: auth-lookup
++//
++// Replaces two database functions that used to be callable by anyone holding the public anon key
++// and that returned real email addresses: get_login_email(username) and get_reset_emails(text).
++// Those lookups now happen HERE, as the service role, and no email address is ever sent to the
++// browser (except back to someone who just proved they know the password but has not verified it).
++//
++//   POST { action: "login", username, password }
++//        200 { session: { access_token, refresh_token } }
++//        401 { error: "invalid_credentials" }        (unknown name and wrong password look the same)
++//        403 { error: "email_not_confirmed", email }
++//        429 { error: "rate_limited" }
++//   POST { action: "reset", identifier, redirectTo? }
++//        200 { ok: true }                            (always, whether or not the account exists)
++//        429 { error: "rate_limited" }
++//
++// Deploy WITH jwt verification (the default; the app sends its anon key). Needs no extra secrets:
++// SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
++// Needs migration 20261118000000_security_hardening.sql (auth_throttle_hit).
++
++import { createClient } from "npm:@supabase/supabase-js@2";
++import {
++  clientKey,
++  LIMITS,
++  parseRequest,
++  resetTargets,
++  type LoginRequest,
++  type ResetRequest,
++} from "./logic.ts";
++
++const CORS = {
++  "access-control-allow-origin": "*",
++  "access-control-allow-headers": "authorization, apikey, content-type, x-client-info",
++  "access-control-allow-methods": "POST, OPTIONS",
++};
++const json = (status: number, body: unknown) =>
++  new Response(JSON.stringify(body), {
++    status,
++    headers: { ...CORS, "content-type": "application/json", "cache-control": "no-store" },
++  });
++
++const url = Deno.env.get("SUPABASE_URL")!;
++const admin = createClient(url, Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!, {
++  auth: { persistSession: false, autoRefreshToken: false },
++});
++// A throwaway client for the actual password check / reset mail: it must never keep a session.
++const publicClient = () =>
++  createClient(url, Deno.env.get("SUPABASE_ANON_KEY")!, {
++    auth: { persistSession: false, autoRefreshToken: false },
++  });
++
++async function allowed(key: string, limit: { max: number; windowSeconds: number }) {
++  const { data, error } = await admin.rpc("auth_throttle_hit", {
++    p_key: key,
++    p_max: limit.max,
++    p_window: `${limit.windowSeconds} seconds`,
++  });
++  // If the throttle itself is broken, fail CLOSED: refusing a login is better than no limit.
++  return !error && data === true;
++}
++
++async function login(req: LoginRequest, ip: string) {
++  if (
++    !(await allowed(`login:ip:${ip}`, LIMITS.loginPerIp)) ||
++    !(await allowed(`login:name:${req.username}`, LIMITS.loginPerName))
++  )
++    return json(429, { error: "rate_limited" });
++
++  const { data: email, error: lookupError } = await admin.rpc("get_login_email", {
++    p_username: req.username,
++  });
++  if (lookupError) {
++    console.error("auth-lookup: get_login_email failed", lookupError.message);
++    return json(502, { error: "unavailable" });
++  }
++  if (typeof email !== "string" || !email) return json(401, { error: "invalid_credentials" });
++
++  const { data, error } = await publicClient().auth.signInWithPassword({
++    email,
++    password: req.password,
++  });
++  if (error || !data.session) {
++    if (error?.code === "email_not_confirmed")
++      return json(403, { error: "email_not_confirmed", email });
++    if (error && (error.status ?? 0) >= 500) return json(502, { error: "unavailable" });
++    return json(401, { error: "invalid_credentials" });
++  }
++  return json(200, {
++    session: { access_token: data.session.access_token, refresh_token: data.session.refresh_token },
++  });
++}
++
++async function reset(req: ResetRequest, ip: string) {
++  if (
++    !(await allowed(`reset:ip:${ip}`, LIMITS.resetPerIp)) ||
++    !(await allowed(`reset:id:${req.identifier}`, LIMITS.resetPerIdentifier))
++  )
++    return json(429, { error: "rate_limited" });
++
++  const { data: found, error } = await admin.rpc("get_reset_emails", {
++    p_identifier: req.identifier,
++  });
++  if (error) console.error("auth-lookup: get_reset_emails failed", error.message);
++  const client = publicClient();
++  for (const target of resetTargets(req.identifier, found)) {
++    const { error: sendError } = await client.auth.resetPasswordForEmail(
++      target,
++      req.redirectTo ? { redirectTo: req.redirectTo } : undefined,
++    );
++    if (sendError) console.error("auth-lookup: reset mail failed", sendError.status);
++  }
++  // Same answer whether or not anything was sent: this endpoint must not reveal which accounts exist.
++  return json(200, { ok: true });
++}
++
++Deno.serve(async (request) => {
++  if (request.method === "OPTIONS") return new Response(null, { status: 204, headers: CORS });
++  if (request.method !== "POST") return json(405, { error: "Use POST." });
++  let body: unknown;
++  try {
++    body = await request.json();
++  } catch {
++    return json(400, { error: "bad_request" });
++  }
++  const parsed = parseRequest(body);
++  if (!parsed) return json(400, { error: "bad_request" });
++  const ip = clientKey(request.headers);
++  try {
++    return parsed.action === "login" ? await login(parsed, ip) : await reset(parsed, ip);
++  } catch (e) {
++    console.error("auth-lookup: unexpected", e instanceof Error ? e.message : e);
++    return json(500, { error: "unavailable" });
++  }
++});
+diff --git a/supabase/functions/auth-lookup/logic.ts b/supabase/functions/auth-lookup/logic.ts
+new file mode 100644
+index 0000000..cb69f31
+--- /dev/null
++++ b/supabase/functions/auth-lookup/logic.ts
+@@ -0,0 +1,90 @@
++// Pure decision logic for the auth-lookup edge function (no Deno or network here, so it is unit
++// tested with vitest like supabase/functions/send-push/logic.ts).
++
++export const USERNAME_RE = /^[a-z0-9_]{3,20}$/;
++
++export type LoginRequest = { action: "login"; username: string; password: string };
++export type ResetRequest = { action: "reset"; identifier: string; redirectTo?: string };
++export type ParsedRequest = LoginRequest | ResetRequest;
++
++/** Attempts allowed per window. Per-IP stops one machine; per-name stops a spread-out guesser. */
++export const LIMITS = {
++  loginPerIp: { max: 20, windowSeconds: 600 },
++  loginPerName: { max: 8, windowSeconds: 600 },
++  resetPerIp: { max: 5, windowSeconds: 3600 },
++  resetPerIdentifier: { max: 3, windowSeconds: 3600 },
++} as const;
++
++/** "@Alice " -> "alice". Only ONE leading @ is dropped, like the rest of the app. */
++export function normalizeUsername(raw: string): string {
++  const t = raw.trim().toLowerCase();
++  return t.startsWith("@") ? t.slice(1) : t;
++}
++
++/** Mirrors get_reset_emails: lower-case, trimmed, and a lone "@name" means the username. */
++export function normalizeIdentifier(raw: string): string {
++  return raw.trim().toLowerCase().slice(0, 254);
++}
++
++export function looksLikeEmail(identifier: string): boolean {
++  return identifier.includes("@") && !identifier.startsWith("@");
++}
++
++/**
++ * Where the reset link may send the person back to: a normal web address or the app's own
++ * sabzone:// link. Anything else (javascript:, data:, huge strings) is dropped, and Supabase then
++ * uses the project's default Site URL. Supabase additionally checks its own redirect allow-list.
++ */
++export function safeRedirect(value: unknown): string | undefined {
++  if (typeof value !== "string" || value.length === 0 || value.length > 500) return undefined;
++  try {
++    const u = new URL(value);
++    if (u.protocol === "https:" || u.protocol === "http:" || u.protocol === "sabzone:")
++      return value;
++  } catch {
++    /* not a URL */
++  }
++  return undefined;
++}
++
++export function parseRequest(body: unknown): ParsedRequest | null {
++  if (typeof body !== "object" || body === null) return null;
++  const b = body as {
++    action?: unknown;
++    username?: unknown;
++    password?: unknown;
++    identifier?: unknown;
++    redirectTo?: unknown;
++  };
++  if (b.action === "login") {
++    if (typeof b.username !== "string" || typeof b.password !== "string") return null;
++    const username = normalizeUsername(b.username);
++    if (!USERNAME_RE.test(username)) return null;
++    if (b.password.length === 0 || b.password.length > 200) return null;
++    return { action: "login", username, password: b.password };
++  }
++  if (b.action === "reset") {
++    if (typeof b.identifier !== "string") return null;
++    const identifier = normalizeIdentifier(b.identifier);
++    if (identifier.length < 2) return null;
++    const redirectTo = safeRedirect(b.redirectTo);
++    return redirectTo
++      ? { action: "reset", identifier, redirectTo }
++      : { action: "reset", identifier };
++  }
++  return null;
++}
++
++/** The caller's address for throttling. Falls back to one shared bucket rather than none. */
++export function clientKey(headers: Pick<Headers, "get">): string {
++  const forwarded = headers.get("x-forwarded-for") ?? headers.get("cf-connecting-ip") ?? "";
++  const first = forwarded.split(",")[0]?.trim();
++  return first && first.length <= 64 ? first : "unknown";
++}
++
++/** Reset targets for a request: what the lookup found, or the typed email as a harmless fallback. */
++export function resetTargets(identifier: string, found: unknown): string[] {
++  const list = Array.isArray(found) ? found.filter((e): e is string => typeof e === "string") : [];
++  if (list.length === 0 && looksLikeEmail(identifier)) return [identifier];
++  return [...new Set(list)].slice(0, 3); // an email can own at most 3 accounts
++}
+diff --git a/supabase/migrations/20261118000000_security_hardening.sql b/supabase/migrations/20261118000000_security_hardening.sql
+new file mode 100644
+index 0000000..447f01f
+--- /dev/null
++++ b/supabase/migrations/20261118000000_security_hardening.sql
+@@ -0,0 +1,189 @@
++-- Security hardening (audit 2026-11-18). Additive and safe to apply on its own: no existing app
++-- feature depends on anything this removes. The one breaking step (taking the username -> email
++-- lookups away from signed-out visitors) is deliberately a SEPARATE file,
++-- 20261118000001_revoke_email_lookup.sql, to be applied last. See docs/SECURITY-PATCH.md.
++--
++-- Contents
++--   1. profiles: clients can no longer rewrite id / created_at (referral window bypass)
++--   2. storage: nobody can LIST other people's files any more (public SELECT policies dropped);
++--      chat-media gets a file-type allow-list
++--   3. function EXECUTE: signed-out visitors keep only the three RPCs the sign-up page needs
++--   4. table grants: the signed-out role has no table access (RLS already denied it; now it
++--      also has no privilege to fall back on if a policy is ever written wrongly)
++--   5. server-side throttle used by the auth-lookup edge function
++
++-- ------------------------------------------------------------------ 1. profiles system columns
++-- profiles_update_own lets a person update their own row, which included created_at. The referral
++-- rule "accounts older than 7 days cannot claim" reads created_at, so anyone could reset their own
++-- clock. Clients (anon / authenticated) keep whatever the stored value is; SECURITY DEFINER
++-- functions, the service role and migrations are not affected.
++create or replace function public.profiles_protect_system_columns()
++returns trigger
++language plpgsql
++set search_path = public
++as $$
++begin
++  if current_user in ('anon', 'authenticated') then
++    new.id := old.id;
++    new.created_at := old.created_at;
++  end if;
++  return new;
++end;
++$$;
++
++drop trigger if exists profiles_protect_system_columns on public.profiles;
++create trigger profiles_protect_system_columns
++  before update on public.profiles
++  for each row execute function public.profiles_protect_system_columns();
++
++-- ------------------------------------------------------------------ 2. storage
++-- The "<bucket>_public_read" policies let ANYONE (even without logging in, using the public anon
++-- key that ships inside the app) call the storage LIST API and enumerate every file in the bucket:
++-- all direct-message photos and files (chat-media) and all voice notes (voice) included.
++-- Public buckets serve their files by URL without consulting this policy, so removing it does not
++-- break any image or video in the app. Each person keeps read access to their own folder, which
++-- is what upload(upsert), remove() and account deletion (list own folder) need.
++drop policy if exists avatars_public_read on storage.objects;
++drop policy if exists chat_media_public_read on storage.objects;
++drop policy if exists media_public_read on storage.objects;
++drop policy if exists videos_public_read on storage.objects;
++drop policy if exists voice_public_read on storage.objects;
++
++drop policy if exists avatars_select_own_folder on storage.objects;
++create policy avatars_select_own_folder on storage.objects for select to authenticated
++  using (bucket_id = 'avatars' and (storage.foldername(name))[1] = auth.uid()::text);
++drop policy if exists chat_media_select_own_folder on storage.objects;
++create policy chat_media_select_own_folder on storage.objects for select to authenticated
++  using (bucket_id = 'chat-media' and (storage.foldername(name))[1] = auth.uid()::text);
++drop policy if exists media_select_own_folder on storage.objects;
++create policy media_select_own_folder on storage.objects for select to authenticated
++  using (bucket_id = 'media' and (storage.foldername(name))[1] = auth.uid()::text);
++drop policy if exists videos_select_own_folder on storage.objects;
++create policy videos_select_own_folder on storage.objects for select to authenticated
++  using (bucket_id = 'videos' and (storage.foldername(name))[1] = auth.uid()::text);
++drop policy if exists voice_select_own_folder on storage.objects;
++create policy voice_select_own_folder on storage.objects for select to authenticated
++  using (bucket_id = 'voice' and (storage.foldername(name))[1] = auth.uid()::text);
++
++-- chat-media had a size limit but accepted any file type (HTML, SVG, scripts) on your Supabase
++-- domain. Allow the kinds of file the chat actually sends. SVG and HTML are intentionally absent.
++update storage.buckets
++   set allowed_mime_types = array[
++     'image/jpeg', 'image/png', 'image/webp', 'image/gif', 'image/heic', 'image/heif', 'image/avif',
++     'video/mp4', 'video/webm', 'video/quicktime',
++     'audio/mpeg', 'audio/mp4', 'audio/webm', 'audio/ogg', 'audio/wav', 'audio/aac', 'audio/x-m4a',
++     'application/pdf', 'application/msword',
++     'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
++     'application/vnd.ms-excel',
++     'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
++     'application/vnd.ms-powerpoint',
++     'application/vnd.openxmlformats-officedocument.presentationml.presentation',
++     'text/plain', 'text/csv', 'text/markdown', 'application/rtf', 'text/rtf', 'application/json',
++     'application/zip', 'application/x-zip-compressed', 'application/vnd.rar',
++     'application/x-rar-compressed', 'application/octet-stream'
++   ]
++ where id = 'chat-media';
++
++-- ------------------------------------------------------------------ 3. function EXECUTE
++-- Postgres gives every new function to PUBLIC, and Supabase also grants it to anon. Earlier
++-- migrations remembered to revoke that on most functions but not all (24 were still callable by
++-- a signed-out visitor, trigger functions included). Reset every function in the public schema:
++--   * signed-out visitors keep ONLY what the sign-up / invite pages call
++--   * signed-in users and the service role keep EXACTLY the access they had (never more)
++--   * trigger functions are callable by nobody (triggers still fire; they do not check EXECUTE)
++-- The two username -> email lookups are left alone here and handled in the next migration, so the
++-- app keeps working until the replacement edge function is deployed.
++do $$
++declare
++  r record;
++  anon_ok constant text[] := array['get_referrer', 'is_username_available', 'plan_signup_email'];
++  later   constant text[] := array['get_login_email', 'get_reset_emails'];
++begin
++  for r in
++    select p.oid, p.oid::regprocedure as sig, p.proname, p.prorettype = 'trigger'::regtype as is_trigger,
++           -- remember who can call it TODAY; some helpers (can_view_post, blocked_between,
++           -- is_profile_visible_for) are deliberately NOT callable by signed-in users because they
++           -- take arbitrary user ids. Never widen that.
++           has_function_privilege('authenticated', p.oid, 'execute') as auth_had,
++           has_function_privilege('service_role', p.oid, 'execute') as service_had
++      from pg_proc p
++      join pg_namespace n on n.oid = p.pronamespace
++     where n.nspname = 'public'
++       and p.prokind in ('f', 'p')
++       and not exists (select 1 from pg_depend d where d.objid = p.oid and d.deptype = 'e')
++  loop
++    continue when r.proname = any (later);
++    execute format('revoke execute on function %s from public, anon', r.sig);
++    if r.is_trigger then
++      execute format('revoke execute on function %s from authenticated, service_role', r.sig);
++    else
++      -- re-grant explicitly only what existed (revoking PUBLIC must not lock anyone out)
++      if r.auth_had then execute format('grant execute on function %s to authenticated', r.sig); end if;
++      if r.service_had then execute format('grant execute on function %s to service_role', r.sig); end if;
++      if r.proname = any (anon_ok) then
++        execute format('grant execute on function %s to anon', r.sig);
++      end if;
++    end if;
++  end loop;
++end $$;
++
++-- Nothing in the app calls get_login_emails (email -> account emails). It only helps someone who
++-- is probing which emails are registered, so no client role needs it.
++revoke execute on function public.get_login_emails(text) from public, anon, authenticated;
++grant  execute on function public.get_login_emails(text) to service_role;
++
++-- Functions created from now on are not callable by signed-out visitors unless a migration says so.
++alter default privileges in schema public revoke execute on functions from anon;
++alter default privileges revoke execute on functions from public;
++
++-- ------------------------------------------------------------------ 4. table grants
++-- Every table already has RLS and every policy is "to authenticated", so the signed-out role could
++-- read nothing. It still held SELECT/INSERT/UPDATE/DELETE grants on all of them (Supabase's
++-- default), leaving RLS as the only wall. Take the grants away as a second wall.
++revoke all on all tables in schema public from anon;
++revoke all on all sequences in schema public from anon;
++alter default privileges in schema public revoke all on tables from anon;
++alter default privileges in schema public revoke all on sequences from anon;
++
++-- ------------------------------------------------------------------ 5. auth throttle
++-- Used by the auth-lookup edge function (service role only) to slow down password guessing and
++-- reset-email spam. Lives in the private schema, which the API does not expose.
++create schema if not exists private;
++revoke all on schema private from public, anon, authenticated;
++
++create table if not exists private.auth_throttle (
++  key text not null,
++  at  timestamptz not null default now()
++);
++create index if not exists auth_throttle_key_at_idx on private.auth_throttle (key, at desc);
++alter table private.auth_throttle enable row level security;
++revoke all on private.auth_throttle from public, anon, authenticated;
++
++-- true  = allowed (and counted); false = over the limit, the caller should refuse.
++create or replace function public.auth_throttle_hit(p_key text, p_max integer, p_window interval)
++returns boolean
++language plpgsql
++security definer
++set search_path = public, private
++as $$
++declare
++  v_count integer;
++begin
++  if coalesce(p_key, '') = '' or p_max < 1 then
++    return false;
++  end if;
++  delete from private.auth_throttle where key = p_key and at < now() - p_window;
++  select count(*) into v_count from private.auth_throttle where key = p_key;
++  if v_count >= p_max then
++    return false;
++  end if;
++  insert into private.auth_throttle (key) values (p_key);
++  -- housekeeping: keep the table small without needing a cron job
++  if random() < 0.02 then
++    delete from private.auth_throttle where at < now() - interval '1 day';
++  end if;
++  return true;
++end;
++$$;
++revoke all on function public.auth_throttle_hit(text, integer, interval) from public, anon, authenticated;
++grant execute on function public.auth_throttle_hit(text, integer, interval) to service_role;
+diff --git a/supabase/migrations/20261118000001_revoke_email_lookup.sql b/supabase/migrations/20261118000001_revoke_email_lookup.sql
+new file mode 100644
+index 0000000..d095a60
+--- /dev/null
++++ b/supabase/migrations/20261118000001_revoke_email_lookup.sql
+@@ -0,0 +1,21 @@
++-- Security fix S1 (Critical): stop turning a username into an email address for the public.
++--
++-- get_login_email('alice') returned alice's real email address to ANYONE holding the public anon
++-- key (and to every signed-in user), no password needed. get_reset_emails('alice') did the same
++-- and also accepted an email address. That is an account-enumeration and phishing/spam gift.
++--
++-- The app now does these lookups on the server, in the `auth-lookup` edge function, which runs as
++-- the service role and never sends an email address back to the browser.
++--
++-- !! APPLY THIS FILE LAST. Order of rollout (full steps in docs/SECURITY-PATCH.md):
++--      1. apply 20261118000000_security_hardening.sql
++--      2. deploy the edge function:  supabase functions deploy auth-lookup
++--      3. ship the app version that calls it (it falls back to the old RPCs until step 4)
++--      4. apply THIS file
++--    If this file is applied before steps 2 and 3, username login and "forgot password" stop
++--    working until they are done.
++
++revoke execute on function public.get_login_email(text)  from public, anon, authenticated;
++revoke execute on function public.get_reset_emails(text) from public, anon, authenticated;
++grant  execute on function public.get_login_email(text)  to service_role;
++grant  execute on function public.get_reset_emails(text) to service_role;
+diff --git a/supabase/tests/replay/00_supabase_stub.sql b/supabase/tests/replay/00_supabase_stub.sql
+index 61cc801..3b97453 100644
+--- a/supabase/tests/replay/00_supabase_stub.sql
++++ b/supabase/tests/replay/00_supabase_stub.sql
