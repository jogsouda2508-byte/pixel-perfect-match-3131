+    "<!doctype",
+    "<html",
+    "<svg",
+    "<script",
+    "<?xml",
+    "<iframe",
+    "<body",
+    "<head",
+    "<meta",
+    "<object",
+    "<embed",
+  ].some((p) => head.startsWith(p));
+}
+
+/* ------------------------------------------------------------------ */
+/* Video and audio containers                                          */
+/* ------------------------------------------------------------------ */
+
+export type VideoKind = {
+  mime: "video/mp4" | "video/quicktime" | "video/webm";
+  ext: "mp4" | "mov" | "webm";
+  container: "isobmff" | "webm";
+};
