+        () => {},
+      ),
+    ).rejects.toThrow(/real MP4/);
+    expect(sent).toHaveLength(0);
+  });
+});
diff --git a/supabase/migrations/20261116000000_upload_security.sql b/supabase/migrations/20261116000000_upload_security.sql
new file mode 100644
index 0000000..7ba322a
--- /dev/null
+++ b/supabase/migrations/20261116000000_upload_security.sql
@@ -0,0 +1,199 @@
+-- Upload security (audit findings S2, S3).
+--
+--   1. Every bucket gets a server-side allow-list of file TYPES and file EXTENSIONS. The browser
+--      checks are only a convenience; this is the part an attacker with the public anon key and a
+--      valid login cannot skip.
+--   2. `chat-media` and `voice` hold private conversations, so they become PRIVATE buckets: a file
+--      can be read only by the person who uploaded it and by the members of a conversation that
+--      has a message pointing at it. The app shows them through short-lived signed URLs
+--      (src/lib/private-media.ts).
+--
+-- ORDER OF ROLLOUT (important):
+--   a) ship the app version that contains src/lib/private-media.ts first. It works with public
+--      AND private buckets, so nothing changes for people yet;
+--   b) then run this file;
+--   Running this file while people still use an older app build makes chat photos/voice notes show
+--   as "unavailable" in those old builds until they update.
+--
+-- ROLLBACK (if something looks wrong after applying):
+--   update storage.buckets set public = true where id in ('chat-media', 'voice');
+--   create policy "chat_media_public_read" on storage.objects for select using (bucket_id = 'chat-media');
+--   create policy "voice_public_read"      on storage.objects for select using (bucket_id = 'voice');
+--   update storage.buckets set allowed_mime_types = null where id = 'chat-media';
+--
+-- Safe to re-run.
+
+-- ---------------------------------------------------------------------
+-- 1. Allowed types per bucket
+-- ---------------------------------------------------------------------
+-- chat-media had NO allow-list: any type (HTML, SVG, APK ...) could be hosted from our domain.
+update storage.buckets
+   set public = false,
+       file_size_limit = 15728640,
+       allowed_mime_types = array[
+         'image/jpeg', 'image/png', 'image/webp', 'image/gif',
+         'application/pdf',
+         'application/msword',
+         'application/vnd.ms-excel',
+         'application/vnd.ms-powerpoint',
+         'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
+         'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+         'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+         'application/zip', 'application/vnd.rar',
+         'application/rtf', 'text/plain', 'text/csv', 'application/json'
+       ]
+ where id = 'chat-media';
+
+update storage.buckets set public = false where id = 'voice';
+
+-- ---------------------------------------------------------------------
+-- 2. Who may read a private chat file
+-- ---------------------------------------------------------------------
+-- Messages store the public-style URL of the file. This extracts "<uid>/<file>" from it so a file
+-- can be matched to the message(s) that reference it (immutable, so it can be indexed).
+create or replace function public.storage_object_path(p_url text, p_bucket text)
+returns text
+language sql
+immutable
+parallel safe
+as $$
+  select substring(p_url from ('/storage/v1/object/public/' || p_bucket || '/([^?]+)'));
+$$;
+
+create index if not exists messages_chat_image_path_idx
+  on public.messages (public.storage_object_path(image_url, 'chat-media'))
+  where image_url is not null;
+create index if not exists messages_chat_file_path_idx
+  on public.messages (public.storage_object_path(file_url, 'chat-media'))
+  where file_url is not null;
+create index if not exists messages_voice_path_idx
+  on public.messages (public.storage_object_path(audio_url, 'voice'))
+  where audio_url is not null;
+
+-- True when the signed-in person is in a conversation that has a message pointing at this file.
+create or replace function public.can_read_chat_object(p_bucket text, p_name text)
+returns boolean
+language sql
+security definer
+stable
+set search_path = public
+as $$
+  select exists (
+    select 1
+    from public.messages m
+    where public.is_conversation_member(m.conversation_id)
+      and (
+        (p_bucket = 'chat-media' and (
+              public.storage_object_path(m.image_url, 'chat-media') = p_name
+           or public.storage_object_path(m.file_url,  'chat-media') = p_name))
+        or
+        (p_bucket = 'voice' and public.storage_object_path(m.audio_url, 'voice') = p_name)
+      )
+  );
+$$;
+revoke all on function public.can_read_chat_object(text, text) from public, anon;
+grant execute on function public.can_read_chat_object(text, text) to authenticated;
+
+-- The old policies let ANYONE (even without logging in) read and list every chat file.
+drop policy if exists "chat_media_public_read" on storage.objects;
+drop policy if exists "chat_media_read_own_or_member" on storage.objects;
+create policy "chat_media_read_own_or_member"
+  on storage.objects for select to authenticated
+  using (
+    bucket_id = 'chat-media'
+    and ((storage.foldername(name))[1] = auth.uid()::text
+         or public.can_read_chat_object('chat-media', name))
+  );
+
+drop policy if exists "voice_public_read" on storage.objects;
+drop policy if exists "voice_read_own_or_member" on storage.objects;
+create policy "voice_read_own_or_member"
+  on storage.objects for select to authenticated
+  using (
+    bucket_id = 'voice'
+    and ((storage.foldername(name))[1] = auth.uid()::text
+         or public.can_read_chat_object('voice', name))
+  );
+
+-- ---------------------------------------------------------------------
+-- 3. File EXTENSION allow-list on every upload (own folder only, as before)
+-- ---------------------------------------------------------------------
+-- The mime allow-list above checks what the uploader SAYS the file is; the extension is part of the
+-- object name, so it is checked here too ("evil.html" can no longer be stored as an "image").
+create or replace function public.upload_ext_ok(p_name text, p_allowed text[])
+returns boolean
+language sql
+immutable
+parallel safe
+as $$
+  select lower(coalesce((regexp_match(p_name, '\.([^./]+)$'))[1], '')) = any (p_allowed);
+$$;
+
+drop policy if exists "avatars_insert_own_folder" on storage.objects;
+create policy "avatars_insert_own_folder"
+  on storage.objects for insert to authenticated
+  with check (
+    bucket_id = 'avatars'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['jpg', 'png', 'webp', 'gif'])
+  );
+
+drop policy if exists "avatars_update_own_folder" on storage.objects;
+create policy "avatars_update_own_folder"
+  on storage.objects for update to authenticated
+  using      (bucket_id = 'avatars' and (storage.foldername(name))[1] = auth.uid()::text)
+  with check (
+    bucket_id = 'avatars'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['jpg', 'png', 'webp', 'gif'])
+  );
+
+drop policy if exists "media_insert_own_folder" on storage.objects;
+create policy "media_insert_own_folder"
+  on storage.objects for insert to authenticated
+  with check (
+    bucket_id = 'media'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['jpg', 'png', 'webp', 'gif'])
+  );
+
+drop policy if exists "videos_insert_own_folder" on storage.objects;
+create policy "videos_insert_own_folder"
+  on storage.objects for insert to authenticated
+  with check (
+    bucket_id = 'videos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['mp4', 'mov', 'webm'])
+  );
+
+drop policy if exists "videos_update_own_folder" on storage.objects;
+create policy "videos_update_own_folder"
+  on storage.objects for update to authenticated
+  using      (bucket_id = 'videos' and (storage.foldername(name))[1] = auth.uid()::text)
+  with check (
+    bucket_id = 'videos'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['mp4', 'mov', 'webm'])
+  );
+
+drop policy if exists "voice_insert_own_folder" on storage.objects;
+create policy "voice_insert_own_folder"
+  on storage.objects for insert to authenticated
+  with check (
+    bucket_id = 'voice'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array['webm', 'm4a', 'ogg', 'mp3'])
+  );
+
+drop policy if exists "chat_media_insert_own_folder" on storage.objects;
+create policy "chat_media_insert_own_folder"
+  on storage.objects for insert to authenticated
+  with check (
+    bucket_id = 'chat-media'
+    and (storage.foldername(name))[1] = auth.uid()::text
+    and public.upload_ext_ok(name, array[
+      'jpg', 'png', 'webp', 'gif',
+      'pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx',
+      'txt', 'csv', 'json', 'rtf', 'zip', 'rar'
+    ])
+  );
diff --git a/supabase/migrations/20261116000001_public_bucket_listing.sql b/supabase/migrations/20261116000001_public_bucket_listing.sql
new file mode 100644
index 0000000..2e3cded
--- /dev/null
+++ b/supabase/migrations/20261116000001_public_bucket_listing.sql
@@ -0,0 +1,41 @@
+-- Stop strangers from LISTING every file in the public buckets.
+--
+-- `avatars`, `media` and `videos` are public buckets on purpose: posts and profile photos are
+-- shown through plain URLs. But each also had a policy "for select using (bucket_id = '...')"
+-- granted to everybody, which is what the storage API consults for list/search calls. With only the
+-- public anon key, anyone could therefore enumerate every uploaded path (<user id>/<file id>),
+-- including media attached to followers-only posts and close-friends stories, whose only protection
+-- is that the URL is hard to guess.
+--
+-- Public URLs (/storage/v1/object/public/<bucket>/<path>) do not go through these policies, so
+-- images and videos keep loading. The owner keeps SELECT on their own folder (needed for upsert
+-- of avatars, for "delete my account" which lists the person's files, and for remove()).
+--
+-- !! VERIFY ON A STAGING PROJECT FIRST !! This relies on Supabase serving public-bucket URLs
+-- without consulting RLS, which is documented behaviour but was not testable offline. After
+-- applying, open a post image, a profile photo and a video in a logged-out browser window.
+--
+-- ROLLBACK:
+--   create policy "avatars_public_read" on storage.objects for select using (bucket_id = 'avatars');
+--   create policy "media_public_read"   on storage.objects for select using (bucket_id = 'media');
+--   create policy "videos_public_read"  on storage.objects for select using (bucket_id = 'videos');
+--
+-- Safe to re-run.
+
+drop policy if exists "avatars_public_read" on storage.objects;
+drop policy if exists "avatars_read_own" on storage.objects;
+create policy "avatars_read_own"
+  on storage.objects for select to authenticated
+  using (bucket_id = 'avatars' and (storage.foldername(name))[1] = auth.uid()::text);
+
+drop policy if exists "media_public_read" on storage.objects;
+drop policy if exists "media_read_own" on storage.objects;
+create policy "media_read_own"
+  on storage.objects for select to authenticated
+  using (bucket_id = 'media' and (storage.foldername(name))[1] = auth.uid()::text);
+
+drop policy if exists "videos_public_read" on storage.objects;
+drop policy if exists "videos_read_own" on storage.objects;
+create policy "videos_read_own"
+  on storage.objects for select to authenticated
+  using (bucket_id = 'videos' and (storage.foldername(name))[1] = auth.uid()::text);
diff --git a/supabase/tests/replay/upload_security.assert.sql b/supabase/tests/replay/upload_security.assert.sql
new file mode 100644
index 0000000..3b54fe6
--- /dev/null
+++ b/supabase/tests/replay/upload_security.assert.sql
@@ -0,0 +1,139 @@
+-- Upload-security policies (20261116000000 / 20261116000001), enforced with ASSERT.
+-- Runs inside one transaction and rolls back.
+begin;
+
+-- the stub gives the API roles no table rights on storage.objects; real Supabase does.
+grant select, insert, update, delete on storage.objects to authenticated;
+grant select on storage.objects to anon;
+
+insert into auth.users (id, email, raw_user_meta_data) values
+  ('00000000-0000-0000-0000-0000000000a1', 'a@test.local', '{"username":"sender","full_name":"Sender"}'),
+  ('00000000-0000-0000-0000-0000000000b2', 'b@test.local', '{"username":"friend","full_name":"Friend"}'),
+  ('00000000-0000-0000-0000-0000000000c3', 'c@test.local', '{"username":"outsider","full_name":"Outsider"}');
+
+-- ---- bucket settings --------------------------------------------------------------------------
+do $$ begin
+  assert (select public from storage.buckets where id = 'chat-media') = false, 'chat-media is private';
+  assert (select public from storage.buckets where id = 'voice') = false,      'voice is private';
+  assert (select public from storage.buckets where id = 'media'),              'media stays public';
+  assert (select public from storage.buckets where id = 'avatars'),            'avatars stays public';
+  assert (select public from storage.buckets where id = 'videos'),             'videos stays public';
+  assert (select allowed_mime_types from storage.buckets where id = 'chat-media') is not null,
+         'chat-media now has a mime allow-list';
+  assert not ((select allowed_mime_types from storage.buckets where id = 'chat-media')
+              && array['text/html', 'image/svg+xml', 'application/vnd.android.package-archive',
+                       'application/x-msdownload', 'application/octet-stream']),
+         'html / svg / apk / exe / unknown types are not allowed in chat-media';
+  assert (select file_size_limit from storage.buckets where id = 'chat-media') = 15728640, 'size limit kept';
+end $$;
+
+-- ---- a private conversation with a photo and a voice note -----------------------------------
+insert into public.conversations (id) values ('11111111-1111-1111-1111-111111111111');
+insert into public.conversation_participants (conversation_id, user_id) values
+  ('11111111-1111-1111-1111-111111111111', '00000000-0000-0000-0000-0000000000a1'),
+  ('11111111-1111-1111-1111-111111111111', '00000000-0000-0000-0000-0000000000b2');
+
+insert into storage.objects (bucket_id, name, owner) values
+  ('chat-media', '00000000-0000-0000-0000-0000000000a1/photo.jpg', '00000000-0000-0000-0000-0000000000a1'),
+  ('chat-media', '00000000-0000-0000-0000-0000000000a1/orphan.jpg', '00000000-0000-0000-0000-0000000000a1'),
+  ('voice',      '00000000-0000-0000-0000-0000000000a1/note.webm',  '00000000-0000-0000-0000-0000000000a1'),
+  ('media',      '00000000-0000-0000-0000-0000000000a1/posts/p.jpg','00000000-0000-0000-0000-0000000000a1');
+
+insert into public.messages (conversation_id, sender_id, body, image_url) values
+  ('11111111-1111-1111-1111-111111111111', '00000000-0000-0000-0000-0000000000a1', 'pic',
+   'https://x.supabase.co/storage/v1/object/public/chat-media/00000000-0000-0000-0000-0000000000a1/photo.jpg');
+insert into public.messages (conversation_id, sender_id, body, audio_url, audio_seconds) values
+  ('11111111-1111-1111-1111-111111111111', '00000000-0000-0000-0000-0000000000a1', 'Voice message',
+   'https://x.supabase.co/storage/v1/object/public/voice/00000000-0000-0000-0000-0000000000a1/note.webm', 3);
+
+-- ---- the sender -----------------------------------------------------------------------------
+select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000a1', true);
+set local role authenticated;
+do $$ begin
+  assert (select count(*) from storage.objects where bucket_id = 'chat-media') = 2, 'sender sees their own chat files';
+  assert (select count(*) from storage.objects where bucket_id = 'voice') = 1,      'sender sees their own voice note';
+  assert (select count(*) from storage.objects where bucket_id = 'media') = 1,      'owner can read own public-bucket files';
+end $$;
+
+-- uploads: allowed types go through, everything else is refused by the extension rule
+do $$ declare me text := '00000000-0000-0000-0000-0000000000a1'; begin
+  insert into storage.objects (bucket_id, name, owner) values ('chat-media', me || '/ok.pdf', me::uuid);
+  insert into storage.objects (bucket_id, name, owner) values ('chat-media', me || '/OK2.JPG', me::uuid);
+  insert into storage.objects (bucket_id, name, owner) values ('media', me || '/posts/ok.webp', me::uuid);
+  insert into storage.objects (bucket_id, name, owner) values ('videos', me || '/ok.mp4', me::uuid);
+  insert into storage.objects (bucket_id, name, owner) values ('avatars', me || '/avatar.jpg', me::uuid);
+  insert into storage.objects (bucket_id, name, owner) values ('voice', me || '/ok.m4a', me::uuid);
+end $$;
+do $$
+declare me text := '00000000-0000-0000-0000-0000000000a1'; bad text[][] := array[
+  array['chat-media', 'evil.html'], array['chat-media', 'evil.svg'], array['chat-media', 'run.exe'],
+  array['chat-media', 'app.apk'],   array['chat-media', 'noextension'], array['chat-media', 'x.pdf.html'],
+  array['media', 'posts/evil.svg'], array['media', 'posts/evil.html'], array['media', 'posts/evil.js'],
+  array['avatars', 'avatar.svg'],   array['videos', 'evil.html'],      array['videos', 'evil.exe'],
+  array['voice', 'evil.html']];
+  i int; refused boolean;
+begin
+  for i in 1 .. array_length(bad, 1) loop
+    refused := false;
+    begin
+      insert into storage.objects (bucket_id, name, owner) values (bad[i][1], me || '/' || bad[i][2], me::uuid);
+    exception when insufficient_privilege or check_violation then refused := true; end;
+    assert refused, format('upload of %s/%s should be refused', bad[i][1], bad[i][2]);
+  end loop;
+end $$;
+-- still cannot write into somebody else's folder
+do $$ declare refused boolean := false; begin
+  begin
+    insert into storage.objects (bucket_id, name, owner)
+    values ('chat-media', '00000000-0000-0000-0000-0000000000b2/x.pdf', '00000000-0000-0000-0000-0000000000a1');
+  exception when insufficient_privilege or check_violation then refused := true; end;
+  assert refused, 'cannot upload into another person''s folder';
+end $$;
+reset role;
+
+-- ---- the person the photo was sent to --------------------------------------------------------
+select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000b2', true);
+set local role authenticated;
+do $$ begin
+  assert exists (select 1 from storage.objects where name = '00000000-0000-0000-0000-0000000000a1/photo.jpg'),
+         'conversation member can read the photo in their chat';
+  assert exists (select 1 from storage.objects where name = '00000000-0000-0000-0000-0000000000a1/note.webm'),
+         'conversation member can read the voice note';
+  assert not exists (select 1 from storage.objects where name = '00000000-0000-0000-0000-0000000000a1/orphan.jpg'),
+         'a file that was never sent in a conversation stays private to its owner';
+  assert not exists (select 1 from storage.objects where bucket_id = 'media'),
+         'other people can no longer LIST the public media bucket';
+end $$;
+reset role;
+
+-- ---- somebody who is not in the conversation -------------------------------------------------
+select set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000c3', true);
+set local role authenticated;
+do $$ begin
+  assert not exists (select 1 from storage.objects where bucket_id in ('chat-media', 'voice')),
+         'an outsider sees no chat files';
+  assert not public.can_read_chat_object('chat-media', '00000000-0000-0000-0000-0000000000a1/photo.jpg'),
+         'can_read_chat_object is false for an outsider';
+end $$;
+reset role;
+
+-- ---- signed out --------------------------------------------------------------------------------
+set local role anon;
+do $$ begin
+  assert not exists (select 1 from storage.objects),
+         'anonymous visitors can list nothing in any bucket';
+end $$;
+do $$ begin
+  perform public.can_read_chat_object('chat-media', 'x');
+  raise exception 'anon was allowed to call can_read_chat_object';
+exception when insufficient_privilege then null; end $$;
+reset role;
+
+-- ---- the path helper (also what the indexes use) --------------------------------------------
+do $$ begin
+  assert public.storage_object_path('https://x.supabase.co/storage/v1/object/public/chat-media/u/a.jpg?v=1', 'chat-media') = 'u/a.jpg';
+  assert public.storage_object_path('https://x.supabase.co/storage/v1/object/public/voice/u/a.webm', 'chat-media') is null;
+  assert public.storage_object_path(null, 'voice') is null;
+end $$;
+
+rollback;
-- 
