+    });
+    for (let i = 0; i < LIMITS.usernameCheck.ip.limit; i++)
+      await w.call({ action: "username_available", username: "free_one" });
+    expect((await w.call({ action: "username_available", username: "free_one" })).status).toBe(429);
+  });
+});
+
+// ---------------------------------------------------------------------------------------------
+describe("the front door", () => {
+  it("answers browser preflights only for our own origins", async () => {
+    const w = makeWorld();
+    const ok = await w.call(null, { method: "OPTIONS", origin: SITE, raw: "" });
+    expect(ok.status).toBe(204);
+    expect(ok.headers["access-control-allow-origin"]).toBe(SITE);
+    const app = await w.call(null, { method: "OPTIONS", origin: "https://localhost", raw: "" });
+    expect(app.status).toBe(204);
+    const evil = await w.call(
+      { action: "login", username: "asha_01", password: PW },
+      { origin: "https://evil.example" },
+    );
+    expect(evil.status).toBe(403);
+    expect(evil.headers["access-control-allow-origin"]).toBeUndefined();
+  });
+
+  it("only accepts POST, small JSON objects and known actions", async () => {
+    const w = makeWorld();
+    expect((await w.call(null, { method: "GET", raw: "" })).status).toBe(405);
+    expect((await w.call(null, { raw: "{not json" })).status).toBe(400);
+    expect((await w.call(null, { raw: "[1,2]" })).status).toBe(400);
+    expect(
+      (await w.call(null, { raw: JSON.stringify({ action: "login", pad: "x".repeat(5000) }) }))
+        .status,
+    ).toBe(413);
+    expect((await w.call({ action: "delete_everything" })).status).toBe(400);
+    expect((await w.call({})).status).toBe(400);
+  });
+
+  it("marks every answer as not cacheable", async () => {
+    const w = makeWorld();
+    const r = await w.login("asha_01", PW);
+    expect(r.headers["cache-control"]).toBe("no-store");
+  });
+
+  it("refuses to work when the counters are unreachable (fails closed)", async () => {
+    const w = makeWorld({ limiterFails: true });
+    const r = await w.login("asha_01", PW);
+    expect(r.status).toBe(503);
+    expect(w.signInCalls).toHaveLength(0);
+    expect((await w.call({ action: "request_reset", identifier: "asha_01" })).status).toBe(503);
+    expect(w.mails).toHaveLength(0);
+  });
+
+  it("reports a failed lookup as a temporary problem, not as a wrong password", async () => {
+    const w = makeWorld({ directoryFails: true });
+    expect((await w.login("asha_01", PW)).status).toBe(503);
+  });
+
+  it("writes no emails, usernames, passwords or codes to the logs", async () => {
+    const w = makeWorld();
+    await w.login("asha_01", "wrong-password-1");
+    await w.login("asha_01", PW);
+    await w.call({ action: "verify", username: "newbie_02", code: "999999" });
+    await w.call({ action: "request_reset", identifier: "asha.private@gmail.com" });
+    await w.call({
+      action: "signup",
+      email: "z@x.com",
+      username: "zeta_one",
+      full_name: "Z",
+      password: "blue-Tiger-42",
+    });
+    const all = w.logs.join("\n").toLowerCase();
+    expect(w.logs.length).toBeGreaterThan(0);
+    for (const secret of [
+      "asha_01",
+      "newbie_02",
+      "zeta_one",
+      "asha.private",
+      "z@x.com",
+      "wrong-password-1",
+      "blue-tiger-42",
+      "999999",
+      "203.0.113.5",
+    ]) {
+      expect(all).not.toContain(secret);
+    }
+  });
+});
diff --git a/src/test/auth-gateway-logic.test.ts b/src/test/auth-gateway-logic.test.ts
new file mode 100644
index 0000000..970492a
--- /dev/null
+++ b/src/test/auth-gateway-logic.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from "vitest";
+import {
+  checkPassword,
+  clientIp,
+  keyHash,
+  maskEmail,
+  normalizeEmail,
+  normalizeUsername,
+  originAllowed,
+  parseOrigins,
+  redirectAllowed,
+} from "../../supabase/functions/auth-gateway/logic";
+
+describe("normalizeUsername", () => {
+  it("accepts plain, @-prefixed and mixed-case names", () => {
+    expect(normalizeUsername("susheel_08")).toBe("susheel_08");
+    expect(normalizeUsername("@Susheel_08 ")).toBe("susheel_08");
+  });
+  it("rejects anything that is not 3-20 letters, numbers or underscores", () => {
+    for (const bad of [
+      "ab",
+      "a".repeat(21),
+      "has space",
+      "dot.name",
+      "me@x.com",
+      "",
+      "@",
+      5,
+      null,
+    ]) {
+      expect(normalizeUsername(bad)).toBeNull();
+    }
+  });
+});
+
+describe("normalizeEmail", () => {
+  it("trims and lower-cases", () =>
+    expect(normalizeEmail("  Me@Example.COM ")).toBe("me@example.com"));
+  it("rejects bad or oversized values", () => {
+    for (const bad of ["nope", "a@b", "a b@c.com", `${"a".repeat(250)}@x.com`, 3, undefined]) {
+      expect(normalizeEmail(bad)).toBeNull();
+    }
+  });
+});
+
+describe("maskEmail", () => {
+  it("shows only the first letter of each part", () => {
+    expect(maskEmail("john.doe@gmail.com")).toBe("j***@g***.com");
+    expect(maskEmail("a@b.co.in")).toBe("a***@b***.in");
+  });
+  it("never leaks the local part or the full host", () => {
+    const m = maskEmail("verylongname@company.org");
+    expect(m).not.toContain("verylongname");
+    expect(m).not.toContain("company");
+  });
+  it("handles odd input", () => expect(maskEmail("nonsense")).toBe("***"));
+});
+
+describe("checkPassword", () => {
+  it("accepts a decent password", () => expect(checkPassword("blue-Tiger-42")).toBeNull());
+  it("rejects short, long, common and look-alike passwords", () => {
+    expect(checkPassword("short1")).toBe("too_short");
+    expect(checkPassword(undefined)).toBe("too_short");
+    expect(checkPassword("x".repeat(73))).toBe("too_long");
+    expect(checkPassword("é".repeat(40))).toBe("too_long"); // 80 bytes
+    expect(checkPassword("Password123")).toBe("too_common");
+    expect(checkPassword("aaaaaaaa")).toBe("too_common");
+    expect(checkPassword("susheel_08", { username: "susheel_08" })).toBe("too_similar");
+    expect(checkPassword("johnsmith", { email: "johnsmith@x.com" })).toBe("too_similar");
+  });
+});
+
+describe("clientIp", () => {
+  it("prefers the Cloudflare header, then the first forwarded address", () => {
+    expect(clientIp({ "cf-connecting-ip": "1.1.1.1", "x-forwarded-for": "9.9.9.9" })).toBe(
+      "1.1.1.1",
+    );
+    expect(clientIp({ "x-forwarded-for": "2.2.2.2, 3.3.3.3" })).toBe("2.2.2.2");
+    expect(clientIp({ "x-real-ip": "4.4.4.4" })).toBe("4.4.4.4");
+    expect(clientIp({})).toBe("unknown");
+  });
+});
+
+describe("origins and redirects", () => {
+  const allowed = parseOrigins("https://sabzone.onrender.com/, https://app.sabzone.in");
+  it("parses a comma list", () =>
+    expect(allowed).toEqual(["https://sabzone.onrender.com", "https://app.sabzone.in"]));
+  it("allows our sites, the Android app and local dev; refuses everything else", () => {
+    expect(originAllowed("https://sabzone.onrender.com", allowed)).toBe(true);
+    expect(originAllowed("https://localhost", allowed)).toBe(true);
+    expect(originAllowed("capacitor://localhost", allowed)).toBe(true);
+    expect(originAllowed("https://evil.example", allowed)).toBe(false);
+    expect(originAllowed("https://sabzone.onrender.com.evil.example", allowed)).toBe(false);
+    expect(originAllowed(undefined, allowed)).toBe(false);
+  });
+  it("only lets emailed links point at our own site or app", () => {
+    expect(redirectAllowed("https://sabzone.onrender.com/reset-password", allowed)).toBe(true);
+    expect(redirectAllowed("sabzone://reset-password", allowed)).toBe(true);
+    expect(redirectAllowed("sabzone://auth-callback", allowed)).toBe(true);
+    for (const bad of [
+      "https://evil.example/reset-password",
+      "https://sabzone.onrender.com@evil.example/",
+      "https://sabzone.onrender.com.evil.example/",
+      "http://sabzone.onrender.com/reset-password", // wrong scheme for a non-localhost host
+      "javascript:alert(1)",
+      "sabzone://anything-else",
+      "//evil.example",
+      "",
+      42,
+      `https://sabzone.onrender.com/${"a".repeat(400)}`,
+    ]) {
+      expect(redirectAllowed(bad, allowed)).toBe(false);
+    }
+  });
+});
+
+describe("keyHash", () => {
+  it("is stable, secret-dependent, label-separated and hides the value", async () => {
+    const a = await keyHash("secret-one-secret-one-secret-one!", "ip", "1.2.3.4");
+    expect(a).toMatch(/^[0-9a-f]{32}$/);
+    expect(await keyHash("secret-one-secret-one-secret-one!", "ip", "1.2.3.4")).toBe(a);
+    expect(await keyHash("secret-two-secret-two-secret-two!", "ip", "1.2.3.4")).not.toBe(a);
+    expect(await keyHash("secret-one-secret-one-secret-one!", "user", "1.2.3.4")).not.toBe(a);
+    expect(a).not.toContain("1.2.3.4");
+  });
+});
diff --git a/supabase/functions/auth-gateway/core.ts b/supabase/functions/auth-gateway/core.ts
new file mode 100644
index 0000000..e5710f3
--- /dev/null
+++ b/supabase/functions/auth-gateway/core.ts
@@ -0,0 +1,501 @@
+// The auth-gateway rules, written against small interfaces so they can be tested without Deno,
+// Supabase or a network (src/test/auth-gateway-core.test.ts). index.ts plugs in the real parts.
+//
+// What it guarantees:
+//   * Real email addresses never leave the server. People log in and verify by USERNAME.
+//   * Sign-up and password reset answer the same whether or not an email already has accounts.
+//   * A wrong username and a wrong password look identical (same text, same time).
+//   * Every action is rate limited, and repeated wrong passwords / codes lock the target out.
+import {
+  checkPassword,
+  clientIp,
+  maskEmail,
+  normalizeEmail,
+  normalizeUsername,
+  originAllowed,
+  redirectAllowed,
+} from "./logic.ts";
+
+// --------------------------------------------------------------------------- limits (one place)
+export const LIMITS = {
+  login: {
+    ip: { limit: 60, windowSec: 600 },
+    pair: { threshold: 5, baseSec: 30, maxSec: 900, windowSec: 900 }, // this IP + this username
+    user: { threshold: 20, baseSec: 300, maxSec: 1800, windowSec: 3600 }, // any IP, this username
+  },
+  signup: { ip: { limit: 10, windowSec: 3600 }, email: { limit: 5, windowSec: 3600 } },
+  verify: {
+    ip: { limit: 30, windowSec: 600 },
+    user: { threshold: 5, baseSec: 60, maxSec: 3600, windowSec: 3600 },
+  },
+  resend: { ip: { limit: 20, windowSec: 3600 }, user: { limit: 4, windowSec: 3600 } },
+  reset: { ip: { limit: 10, windowSec: 3600 }, target: { limit: 3, windowSec: 3600 } },
+  usernameCheck: { ip: { limit: 120, windowSec: 600 } },
+  /** Failures answer no faster than this, so timing does not tell "no such user" from "bad password". */
+  minFailMs: 600,
+  /** Sign-up and reset do real work (sending mail) only sometimes; pad them all to the same time. */
+  minSlowMs: 900,
+  maxBodyBytes: 4096,
+} as const;
+
+export const MESSAGES = {
+  badLogin: "Incorrect username or password.",
+  tooMany: "Too many attempts. Please wait and try again.",
+  badCode: "That code is incorrect or has expired. Request a new one.",
+  unavailable: "We couldn't complete that right now. Please try again in a moment.",
+} as const;
+
+// --------------------------------------------------------------------------- dependencies
+export type Session = {
+  access_token: string;
+  refresh_token: string;
+  expires_in?: number | undefined;
+  expires_at?: number | undefined;
+  token_type?: string | undefined;
+};
+export type AuthFailure = {
+  code?: string | undefined;
+  status?: number | undefined;
+  message?: string | undefined;
+};
+export type AuthResult = { session: Session | null; error: AuthFailure | null };
+export type SignupPlan = {
+  ok: boolean;
+  reason?: string | undefined;
+  auth_email?: string | undefined;
+};
+type LockCfg = { threshold: number; baseSec: number; maxSec: number; windowSec: number };
+
+export interface Deps {
+  now(): number;
+  sleep(ms: number): Promise<void>;
+  /** Stable pseudonym for a value (HMAC). Used for every key we store. */
+  hash(label: string, value: string): Promise<string>;
+  limiter: {
+    hit(
+      key: string,
+      limit: number,
+      windowSec: number,
+    ): Promise<{ allowed: boolean; retryAfter: number }>;
+  };
+  locks: {
+    status(key: string): Promise<{ locked: boolean; retryAfter: number }>;
+    fail(key: string, cfg: LockCfg): Promise<{ locked: boolean; retryAfter: number }>;
+    clear(key: string): Promise<void>;
+  };
+  directory: {
+    loginEmail(username: string): Promise<string | null>;
+    resetTargets(identifier: string): Promise<string[]>;
+    planSignup(email: string, username: string): Promise<SignupPlan>;
+    usernameFree(username: string): Promise<boolean>;
+  };
+  auth: {
+    signIn(email: string, password: string, captcha?: string): Promise<AuthResult>;
+    signUp(a: {
+      email: string;
+      password: string;
+      meta: Record<string, string>;
+      redirectTo: string;
+      captcha?: string | undefined;
+    }): Promise<AuthResult>;
+    verifyOtp(email: string, code: string): Promise<AuthResult>;
+    resend(email: string, redirectTo: string): Promise<{ error: AuthFailure | null }>;
+    resetForEmail(
+      email: string,
+      redirectTo: string,
+      captcha?: string,
+    ): Promise<{ error: AuthFailure | null }>;
+  };
+  config: { allowedOrigins: string[]; defaultRedirectOrigin: string | null };
+  log(event: string, data?: Record<string, unknown>): void;
+}
+
+export type GatewayRequest = {
+  method: string;
+  headers: Record<string, string | undefined>;
+  /** Raw request text, so the size limit applies before any parsing. */
+  rawBody: string;
+};
+export type GatewayResponse = { status: number; body: unknown; headers: Record<string, string> };
+
+// --------------------------------------------------------------------------- helpers
+const reply = (
+  status: number,
+  body: unknown,
+  extra: Record<string, string> = {},
+): GatewayResponse => ({ status, body, headers: extra });
+const tooMany = (retryAfter: number): GatewayResponse =>
+  reply(
+    429,
+    { error: "too_many_attempts", message: MESSAGES.tooMany, retry_after: retryAfter },
+    { "retry-after": String(retryAfter) },
+  );
+const str = (v: unknown, max: number): string | null =>
+  typeof v === "string" && v.length > 0 && v.length <= max ? v : null;
+
+class Unavailable extends Error {}
+
+export function createGateway(d: Deps) {
+  /** Wait so a response takes at least `minMs` from `started`. */
+  async function padTo(started: number, minMs: number) {
+    const wait = minMs - (d.now() - started);
+    if (wait > 0) await d.sleep(wait);
+  }
+
+  /** Fails closed: if the counters cannot be reached we refuse instead of skipping the limit. */
+  async function hit(key: string, cfg: { limit: number; windowSec: number }) {
+    try {
+      return await d.limiter.hit(key, cfg.limit, cfg.windowSec);
+    } catch (e) {
+      d.log("limiter_error", { message: String(e).slice(0, 120) });
+      throw new Unavailable();
+    }
+  }
+  async function lockStatus(key: string) {
+    try {
+      return await d.locks.status(key);
+    } catch (e) {
+      d.log("lock_error", { message: String(e).slice(0, 120) });
+      throw new Unavailable();
+    }
+  }
+  async function lockFail(key: string, cfg: LockCfg) {
+    try {
+      return await d.locks.fail(key, cfg);
+    } catch (e) {
+      d.log("lock_error", { message: String(e).slice(0, 120) });
+      throw new Unavailable();
+    }
+  }
+
+  function redirectFor(body: Record<string, unknown>, fallbackPath: string): string | null {
+    const origins = d.config.allowedOrigins;
+    if (body["redirect_to"] !== undefined) {
+      return redirectAllowed(body["redirect_to"], origins) ? (body["redirect_to"] as string) : null;
+    }
+    return d.config.defaultRedirectOrigin
+      ? `${d.config.defaultRedirectOrigin}${fallbackPath}`
+      : null;
+  }
+
+  // ------------------------------------------------------------------------- login
+  async function login(body: Record<string, unknown>, ip: string): Promise<GatewayResponse> {
+    const started = d.now();
+    const username = normalizeUsername(body["username"]);
+    const password = str(body["password"], 256);
+    const captcha = str(body["captcha_token"], 2048) ?? undefined;
+
+    const ipH = await d.hash("ip", ip);
+    const ipHit = await hit(`login:ip:${ipH}`, LIMITS.login.ip);
+    if (!ipHit.allowed) return tooMany(ipHit.retryAfter);
+
+    // The same keys are used whether or not the username exists, so locks look identical.
+    const who = username ?? "invalid";
+    const pairKey = `login:pair:${await d.hash("pair", `${ip}|${who}`)}`;
+    const userKey = `login:user:${await d.hash("user", who)}`;
+
+    const [pair, user] = await Promise.all([lockStatus(pairKey), lockStatus(userKey)]);
+    if (pair.locked || user.locked) {
+      d.log("login_locked", { ip: ipH.slice(0, 8) });
+      return tooMany(Math.max(pair.retryAfter, user.retryAfter));
+    }
+
+    const fail = async (): Promise<GatewayResponse> => {
+      const [a, b] = await Promise.all([
+        lockFail(pairKey, LIMITS.login.pair),
+        lockFail(userKey, LIMITS.login.user),
+      ]);
+      await padTo(started, LIMITS.minFailMs);
+      const retry = Math.max(a.retryAfter, b.retryAfter);
+      d.log("login_failed", { ip: ipH.slice(0, 8), locked: a.locked || b.locked });
+      return reply(401, {
+        error: "invalid_credentials",
+        message: MESSAGES.badLogin,
+        ...(retry > 0 ? { retry_after: retry } : {}),
+      });
+    };
+
+    if (!username || !password) return fail();
+
+    let email: string | null;
+    try {
+      email = await d.directory.loginEmail(username);
+    } catch {
+      return reply(503, { error: "unavailable", message: MESSAGES.unavailable });
+    }
+    if (!email) return fail();
+
+    const res = await d.auth.signIn(email, password, captcha);
+    if (res.session) {
+      await Promise.all([d.locks.clear(pairKey), d.locks.clear(userKey)]);
+      d.log("login_ok", { ip: ipH.slice(0, 8) });
+      return reply(200, { ok: true, session: res.session });
+    }
+    const err = res.error;
+    if (err?.code === "email_not_confirmed") {
+      // Supabase only reports this once the password was right, so it is safe to say so. We show a
+      // masked address, never the real one; the code is entered against the username.
+      await Promise.all([d.locks.clear(pairKey), d.locks.clear(userKey)]);
+      return reply(403, { error: "email_not_verified", username, masked_email: maskEmail(email) });
+    }
+    if (err?.code === "invalid_credentials" || err?.status === 400) return fail();
+    if (err?.status === 429) return tooMany(60);
+    d.log("login_upstream_error", { status: err?.status ?? null, code: err?.code ?? null });
+    return reply(502, { error: "unavailable", message: MESSAGES.unavailable });
+  }
+
+  // ------------------------------------------------------------------------- signup
+  async function signup(body: Record<string, unknown>, ip: string): Promise<GatewayResponse> {
+    const started = d.now();
+    const username = normalizeUsername(body["username"]);
+    const email = normalizeEmail(body["email"]);
+    const fullName = typeof body["full_name"] === "string" ? body["full_name"].trim() : "";
+    const password = body["password"];
+
+    if (!username) return reply(400, { error: "invalid_username" });
+    if (!email) return reply(400, { error: "invalid_email" });
+    if (fullName.length < 1 || fullName.length > 80) return reply(400, { error: "invalid_name" });
+    const problem = checkPassword(password, { username, email });
+    if (problem) return reply(400, { error: "weak_password", reason: problem });
+
+    const ipH = await d.hash("ip", ip);
+    const emailH = await d.hash("email", email);
+    const a = await hit(`signup:ip:${ipH}`, LIMITS.signup.ip);
+    if (!a.allowed) return tooMany(a.retryAfter);
+    const b = await hit(`signup:email:${emailH}`, LIMITS.signup.email);
+    if (!b.allowed) return tooMany(b.retryAfter);
+
+    const redirectTo = redirectFor(body, "/home");
+    if (!redirectTo) return reply(400, { error: "invalid_redirect" });
+
+    // Everything below answers with the same shape, so the reply does not reveal whether this
+    // mailbox already has accounts, has reached the limit, or uses an unsupported provider.
+    const generic = async () => {
+      await padTo(started, LIMITS.minSlowMs);
+      return reply(200, {
+        ok: true,
+        needs_verification: true,
+        username,
+        masked_email: maskEmail(email),
+      });
+    };
+
+    let plan: SignupPlan;
+    try {
+      plan = await d.directory.planSignup(email, username);
+    } catch {
+      return reply(503, { error: "unavailable", message: MESSAGES.unavailable });
+    }
+    if (!plan.ok) {
+      if (plan.reason === "username_taken") return reply(409, { error: "username_taken" });
+      if (plan.reason === "invalid_username") return reply(400, { error: "invalid_username" });
+      if (plan.reason === "invalid_email") return reply(400, { error: "invalid_email" });
+      d.log("signup_refused_quietly", { reason: plan.reason ?? "unknown" });
+      return generic();
+    }
+
+    const authEmail = normalizeEmail(plan.auth_email) ?? email;
+    const res = await d.auth.signUp({
+      email: authEmail,
+      password: password as string,
+      meta: { full_name: fullName, username, contact_email: email },
+      redirectTo,
+      captcha: str(body["captcha_token"], 2048) ?? undefined,
+    });
+    if (res.error) {
+      const msg = (res.error.message ?? "").toLowerCase();
+      if (res.error.status === 429 || (res.error.code ?? "").includes("rate_limit"))
+        return tooMany(60);
+      if (res.error.code === "weak_password")
+        return reply(400, { error: "weak_password", reason: "too_common" });
+      if (msg.includes("database error saving new user") || res.error.code === "unexpected_failure")
+        return reply(409, { error: "username_taken" });
+      if (res.error.code === "user_already_exists") return generic();
+      d.log("signup_upstream_error", {
+        status: res.error.status ?? null,
+        code: res.error.code ?? null,
+      });
+      return reply(502, { error: "unavailable", message: MESSAGES.unavailable });
+    }
+    if (res.session) {
+      // Email confirmation is switched off in this project: the account is ready now.
+      return reply(200, { ok: true, needs_verification: false, username, session: res.session });
+    }
+    return generic();
+  }
+
+  // ------------------------------------------------------------------------- verify / resend
+  async function verify(body: Record<string, unknown>, ip: string): Promise<GatewayResponse> {
+    const started = d.now();
+    const username = normalizeUsername(body["username"]);
+    const code = typeof body["code"] === "string" ? body["code"].trim() : "";
+    if (!username || !/^\d{6}$/.test(code))
+      return reply(400, { error: "invalid_code", message: MESSAGES.badCode });
+
+    const ipH = await d.hash("ip", ip);
+    const a = await hit(`verify:ip:${ipH}`, LIMITS.verify.ip);
+    if (!a.allowed) return tooMany(a.retryAfter);
+    const userKey = `verify:user:${await d.hash("user", username)}`;
+    const st = await lockStatus(userKey);
+    if (st.locked) return tooMany(st.retryAfter);
+
+    const fail = async () => {
+      const f = await lockFail(userKey, LIMITS.verify.user);
+      await padTo(started, LIMITS.minFailMs);
+      d.log("verify_failed", { ip: ipH.slice(0, 8), locked: f.locked });
+      return reply(400, {
+        error: "invalid_code",
+        message: MESSAGES.badCode,
+        ...(f.retryAfter > 0 ? { retry_after: f.retryAfter } : {}),
+      });
+    };
+
+    let email: string | null;
+    try {
+      email = await d.directory.loginEmail(username);
+    } catch {
+      return reply(503, { error: "unavailable", message: MESSAGES.unavailable });
+    }
+    if (!email) return fail();
+    const res = await d.auth.verifyOtp(email, code);
+    if (res.session) {
+      await d.locks.clear(userKey);
+      return reply(200, { ok: true, session: res.session });
+    }
+    if (res.error?.status === 429) return tooMany(60);
+    return fail();
+  }
+
+  async function resend(body: Record<string, unknown>, ip: string): Promise<GatewayResponse> {
+    const started = d.now();
+    const username = normalizeUsername(body["username"]);
+    if (!username) return reply(400, { error: "invalid_username" });
+    const ipH = await d.hash("ip", ip);
+    const a = await hit(`resend:ip:${ipH}`, LIMITS.resend.ip);
+    if (!a.allowed) return tooMany(a.retryAfter);
+    const b = await hit(`resend:user:${await d.hash("user", username)}`, LIMITS.resend.user);
+    if (!b.allowed) return tooMany(b.retryAfter);
+
+    const redirectTo = redirectFor(body, "/home");
+    if (!redirectTo) return reply(400, { error: "invalid_redirect" });
+    try {
+      const email = await d.directory.loginEmail(username);
+      if (email) await d.auth.resend(email, redirectTo);
+    } catch (e) {
+      d.log("resend_error", { message: String(e).slice(0, 120) });
+    }
+    await padTo(started, LIMITS.minSlowMs);
+    return reply(200, { ok: true });
+  }
+
+  // ------------------------------------------------------------------------- password reset
+  async function requestReset(body: Record<string, unknown>, ip: string): Promise<GatewayResponse> {
+    const started = d.now();
+    const identifier = str(body["identifier"], 254)?.trim().toLowerCase();
+    if (!identifier) return reply(400, { error: "invalid_identifier" });
+    const redirectTo = redirectFor(body, "/reset-password");
+    if (!redirectTo) return reply(400, { error: "invalid_redirect" });
+
+    const ipH = await d.hash("ip", ip);
+    const a = await hit(`reset:ip:${ipH}`, LIMITS.reset.ip);
+    if (!a.allowed) return tooMany(a.retryAfter);
+    const b = await hit(`reset:target:${await d.hash("target", identifier)}`, LIMITS.reset.target);
+    if (!b.allowed) return tooMany(b.retryAfter);
+
+    // Always the same answer: no hint about whether the username or email has an account.
+    try {
+      const targets = (await d.directory.resetTargets(identifier)).slice(0, 3);
+      for (const t of targets) {
+        const r = await d.auth.resetForEmail(
+          t,
+          redirectTo,
+          str(body["captcha_token"], 2048) ?? undefined,
+        );
+        if (r.error) d.log("reset_send_error", { status: r.error.status ?? null });
+      }
+    } catch (e) {
+      d.log("reset_error", { message: String(e).slice(0, 120) });
+    }
+    await padTo(started, LIMITS.minSlowMs);
+    return reply(200, { ok: true });
+  }
+
+  async function usernameAvailable(
+    body: Record<string, unknown>,
+    ip: string,
+  ): Promise<GatewayResponse> {
+    const username = normalizeUsername(body["username"]);
+    const ipH = await d.hash("ip", ip);
+    const a = await hit(`uname:ip:${ipH}`, LIMITS.usernameCheck.ip);
+    if (!a.allowed) return tooMany(a.retryAfter);
+    if (!username) return reply(200, { available: false });
+    try {
+      return reply(200, { available: await d.directory.usernameFree(username) });
+    } catch {
+      return reply(503, { error: "unavailable", message: MESSAGES.unavailable });
+    }
+  }
+
+  // ------------------------------------------------------------------------- entry point
+  async function handle(req: GatewayRequest): Promise<GatewayResponse> {
+    const origin = req.headers["origin"];
+    const cors: Record<string, string> = {
+      vary: "Origin",
+      "cache-control": "no-store",
+      "x-content-type-options": "nosniff",
+    };
+    if (origin) {
+      if (!originAllowed(origin, d.config.allowedOrigins))
+        return reply(403, { error: "forbidden_origin" }, cors);
+      cors["access-control-allow-origin"] = origin;
+      cors["access-control-allow-headers"] = "authorization, apikey, content-type, x-client-info";
+      cors["access-control-allow-methods"] = "POST, OPTIONS";
+      cors["access-control-max-age"] = "600";
+    }
+    const done = (r: GatewayResponse): GatewayResponse => ({
+      ...r,
+      headers: { ...cors, ...r.headers },
+    });
+
+    if (req.method === "OPTIONS") return done(reply(204, null));
+    if (req.method !== "POST") return done(reply(405, { error: "method_not_allowed" }));
+    if (new TextEncoder().encode(req.rawBody).length > LIMITS.maxBodyBytes)
+      return done(reply(413, { error: "too_large" }));
+
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(req.rawBody);
+    } catch {
+      return done(reply(400, { error: "invalid_json" }));
+    }
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed))
+      return done(reply(400, { error: "invalid_json" }));
+    const body = parsed as Record<string, unknown>;
+    const ip = clientIp(req.headers);
+
+    try {
+      switch (body["action"]) {
+        case "login":
+          return done(await login(body, ip));
+        case "signup":
+          return done(await signup(body, ip));
+        case "verify":
+          return done(await verify(body, ip));
+        case "resend":
+          return done(await resend(body, ip));
+        case "request_reset":
+          return done(await requestReset(body, ip));
+        case "username_available":
+          return done(await usernameAvailable(body, ip));
+        default:
+          return done(reply(400, { error: "unknown_action" }));
+      }
+    } catch (e) {
+      if (!(e instanceof Unavailable))
+        d.log("unhandled_error", { message: String(e).slice(0, 160) });
+      return done(reply(503, { error: "unavailable", message: MESSAGES.unavailable }));
+    }
+  }
+
+  return { handle };
+}
diff --git a/supabase/functions/auth-gateway/index.ts b/supabase/functions/auth-gateway/index.ts
new file mode 100644
index 0000000..8a5af7d
--- /dev/null
+++ b/supabase/functions/auth-gateway/index.ts
@@ -0,0 +1,185 @@
+// Supabase Edge Function: auth-gateway
+//
+// The only door for sign-up, log-in by username, email verification and password reset.
+// It keeps real email addresses on the server, rate limits every action and locks out
+// repeated wrong passwords / codes. The rules live in core.ts (unit tested); this file only
+// connects them to Supabase.
+//
+// Deploy (NOT done by this patch):
+//   supabase functions deploy auth-gateway
+// The default JWT check can stay ON: the browser sends the public key, which is a valid JWT.
+//
+// Secrets (supabase secrets set ...):
+//   AUTH_HASH_SECRET       a long random string (32+ characters). Keys in the database are
+//                          HMACs made with it, so no raw IP, email or username is stored.
+//   AUTH_ALLOWED_ORIGINS   comma list of your website addresses, e.g. https://sabzone.onrender.com
+//                          (the Android app and localhost are always allowed)
+// SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
+
+import { createClient, type AuthError, type Session } from "npm:@supabase/supabase-js@2";
+import { createGateway, LIMITS, type AuthFailure, type Deps, type SignupPlan } from "./core.ts";
+import { keyHash, parseOrigins } from "./logic.ts";
+
+const url = Deno.env.get("SUPABASE_URL") ?? "";
+const anonKey = Deno.env.get("SUPABASE_ANON_KEY") ?? "";
+const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY") ?? "";
+const hashSecret = Deno.env.get("AUTH_HASH_SECRET") ?? "";
+const allowedOrigins = parseOrigins(Deno.env.get("AUTH_ALLOWED_ORIGINS"));
+
+const configured = !!(url && anonKey && serviceKey && hashSecret.length >= 32);
+if (!configured)
+  console.error("auth-gateway: SUPABASE_* keys or AUTH_HASH_SECRET (32+ chars) missing");
+if (allowedOrigins.length === 0) {
+  console.warn(
+    "auth-gateway: AUTH_ALLOWED_ORIGINS is empty, only the Android app and localhost work",
+  );
+}
+
+// Service role: only used to call the database functions in 20261116000000_auth_gateway.sql and
+// the sign-in helpers. It never leaves this file.
+const admin = createClient(url, serviceKey, {
+  auth: { persistSession: false, autoRefreshToken: false },
+});
+// A fresh anon client per call, so no session is ever shared between requests.
+const anon = () =>
+  createClient(url, anonKey, { auth: { persistSession: false, autoRefreshToken: false } });
+
+const failure = (e: AuthError | null): AuthFailure | null =>
+  e ? { code: e.code, status: e.status, message: e.message } : null;
+const sessionOf = (s: Session | null) =>
+  s
+    ? {
+        access_token: s.access_token,
+        refresh_token: s.refresh_token,
+        expires_in: s.expires_in,
+        expires_at: s.expires_at,
+        token_type: s.token_type,
+      }
+    : null;
+
+async function rpc<T>(fn: string, args: Record<string, unknown>): Promise<T> {
+  const { data, error } = await admin.rpc(fn, args);
+  if (error) throw new Error(`${fn}: ${error.message}`);
+  return data as T;
+}
+
+const deps: Deps = {
+  now: () => Date.now(),
+  sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
+  hash: (label, value) => keyHash(hashSecret, label, value),
+  limiter: {
+    async hit(key, limit, windowSec) {
+      const rows = await rpc<{ allowed: boolean; retry_after: number }[]>("auth_gw_rate_hit", {
+        p_key: key,
+        p_limit: limit,
+        p_window_seconds: windowSec,
+      });
+      const r = rows[0];
+      return { allowed: !!r?.allowed, retryAfter: r?.retry_after ?? windowSec };
+    },
+  },
+  locks: {
+    async status(key) {
+      const rows = await rpc<{ locked: boolean; retry_after: number }[]>("auth_gw_lock_status", {
+        p_key: key,
+      });
+      return { locked: !!rows[0]?.locked, retryAfter: rows[0]?.retry_after ?? 0 };
+    },
+    async fail(key, c) {
+      const rows = await rpc<{ locked: boolean; retry_after: number }[]>("auth_gw_lock_fail", {
+        p_key: key,
+        p_threshold: c.threshold,
+        p_base_seconds: c.baseSec,
+        p_max_seconds: c.maxSec,
+        p_window_seconds: c.windowSec,
+      });
+      return { locked: !!rows[0]?.locked, retryAfter: rows[0]?.retry_after ?? 0 };
+    },
+    async clear(key) {
+      await rpc("auth_gw_lock_clear", { p_key: key });
+    },
+  },
+  directory: {
+    loginEmail: async (username) =>
+      (await rpc<string | null>("get_login_email", { p_username: username })) ?? null,
+    resetTargets: async (identifier) =>
+      (await rpc<string[] | null>("get_reset_emails", { p_identifier: identifier })) ?? [],
+    planSignup: (email, username) =>
+      rpc<SignupPlan>("plan_signup_email", { p_email: email, p_username: username }),
+    usernameFree: (username) => rpc<boolean>("is_username_available", { p_username: username }),
+  },
+  auth: {
+    async signIn(email, password, captcha) {
+      const { data, error } = await anon().auth.signInWithPassword({
+        email,
+        password,
+        ...(captcha ? { options: { captchaToken: captcha } } : {}),
+      });
+      return { session: sessionOf(data.session), error: failure(error) };
+    },
+    async signUp({ email, password, meta, redirectTo, captcha }) {
+      const { data, error } = await anon().auth.signUp({
+        email,
+        password,
+        options: {
+          data: meta,
+          emailRedirectTo: redirectTo,
+          ...(captcha ? { captchaToken: captcha } : {}),
+        },
+      });
+      // Supabase hides "email already exists" by returning a user with no identities.
+      if (!error && data.user && (data.user.identities?.length ?? 0) === 0) {
+        return { session: null, error: { code: "user_already_exists", status: 200 } };
+      }
+      return { session: sessionOf(data.session), error: failure(error) };
+    },
+    async verifyOtp(email, code) {
+      const { data, error } = await anon().auth.verifyOtp({ email, token: code, type: "signup" });
+      return { session: sessionOf(data.session), error: failure(error) };
+    },
+    async resend(email, redirectTo) {
+      const { error } = await anon().auth.resend({
+        type: "signup",
+        email,
+        options: { emailRedirectTo: redirectTo },
+      });
+      return { error: failure(error) };
+    },
+    async resetForEmail(email, redirectTo, captcha) {
+      const { error } = await anon().auth.resetPasswordForEmail(email, {
+        redirectTo,
+        ...(captcha ? { captchaToken: captcha } : {}),
+      });
+      return { error: failure(error) };
+    },
+  },
+  config: { allowedOrigins, defaultRedirectOrigin: allowedOrigins[0] ?? null },
+  // One line of JSON per event. Never contains an email, username, password or address.
+  log: (event, data) => console.log(JSON.stringify({ fn: "auth-gateway", event, ...data })),
+};
+
+const gateway = createGateway(deps);
+
+Deno.serve(async (req) => {
+  if (!configured) {
+    return new Response(JSON.stringify({ error: "unavailable" }), {
+      status: 503,
+      headers: { "content-type": "application/json" },
+    });
+  }
+  // Refuse oversized bodies before reading them.
+  if (Number(req.headers.get("content-length") ?? 0) > LIMITS.maxBodyBytes) {
+    return new Response(JSON.stringify({ error: "too_large" }), {
+      status: 413,
+      headers: { "content-type": "application/json" },
+    });
+  }
+  const headers: Record<string, string> = {};
+  req.headers.forEach((v, k) => (headers[k.toLowerCase()] = v));
+  const rawBody = req.method === "POST" ? await req.text() : "";
+  const res = await gateway.handle({ method: req.method, headers, rawBody });
+  return new Response(res.body === null ? null : JSON.stringify(res.body), {
+    status: res.status,
+    headers: { "content-type": "application/json", ...res.headers },
+  });
+});
diff --git a/supabase/functions/auth-gateway/logic.ts b/supabase/functions/auth-gateway/logic.ts
new file mode 100644
index 0000000..9f6a2ad
--- /dev/null
+++ b/supabase/functions/auth-gateway/logic.ts
@@ -0,0 +1,145 @@
+// Pure helpers for the auth-gateway Edge Function. No Deno or network code here, so they are
+// unit-tested with vitest (src/test/auth-gateway-logic.test.ts).
+
+export const USERNAME_RE = /^[a-z0-9_]{3,20}$/;
+// Deliberately simple; the real check is that the mailbox receives the code.
+export const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+/** "@Susheel_08 " -> "susheel_08". Returns null when it is not a valid username. */
+export function normalizeUsername(input: unknown): string | null {
+  if (typeof input !== "string") return null;
+  let v = input.trim().toLowerCase();
+  if (v.startsWith("@")) v = v.slice(1);
+  return USERNAME_RE.test(v) ? v : null;
+}
+
+/** Lower-cased, trimmed email, or null when it does not look like one (max 254 characters). */
+export function normalizeEmail(input: unknown): string | null {
+  if (typeof input !== "string") return null;
+  const v = input.trim().toLowerCase();
+  return v.length <= 254 && EMAIL_RE.test(v) ? v : null;
+}
+
+/** "john.doe@gmail.com" -> "j***@g***.com". Never shows more than the first letter of each part. */
+export function maskEmail(email: string): string {
+  const at = email.lastIndexOf("@");
+  if (at < 1) return "***";
+  const local = email.slice(0, at);
+  const domain = email.slice(at + 1);
+  const dot = domain.lastIndexOf(".");
+  const host = dot > 0 ? domain.slice(0, dot) : domain;
+  const tld = dot > 0 ? domain.slice(dot) : "";
+  return `${local.slice(0, 1)}***@${host.slice(0, 1)}***${tld}`;
+}
+
+const COMMON_PASSWORDS = new Set([
+  "password",
+  "password1",
+  "password12",
+  "password123",
+  "passw0rd",
+  "12345678",
+  "123456789",
+  "1234567890",
+  "11111111",
+  "00000000",
+  "qwertyui",
+  "qwerty123",
+  "qwertyuiop",
+  "iloveyou",
+  "abc12345",
+  "admin123",
+  "welcome1",
+  "letmein1",
+  "sabzone123",
+  "sabzone1",
+]);
+
+export type PasswordProblem = "too_short" | "too_long" | "too_common" | "too_similar";
+
+/**
+ * Server-side password rules (the form checks length too, but the server must not trust it).
+ * Supabase rejects passwords over 72 bytes, so we say so clearly instead of failing late.
+ */
+export function checkPassword(
+  password: unknown,
+  who: { username?: string | null; email?: string | null } = {},
+): PasswordProblem | null {
+  if (typeof password !== "string" || password.length < 8) return "too_short";
+  if (new TextEncoder().encode(password).length > 72) return "too_long";
+  const p = password.toLowerCase();
+  if (COMMON_PASSWORDS.has(p) || /^(.)\1+$/.test(p)) return "too_common";
+  const username = who.username?.toLowerCase();
+  const local = who.email?.toLowerCase().split("@")[0];
+  if ((username && p === username) || (local && local.length >= 4 && p === local))
+    return "too_similar";
+  return null;
+}
+
+/** The caller's address, for rate limits. Cloudflare sets cf-connecting-ip and cannot be spoofed. */
+export function clientIp(headers: Record<string, string | undefined>): string {
+  const cf = headers["cf-connecting-ip"]?.trim();
+  if (cf) return cf;
+  const xff = headers["x-forwarded-for"]?.split(",")[0]?.trim();
+  if (xff) return xff;
+  return headers["x-real-ip"]?.trim() || "unknown";
+}
+
+/** Splits a comma list from a secret into clean origins ("https://a.com, https://b.com"). */
+export function parseOrigins(raw: string | undefined | null): string[] {
+  return (raw ?? "")
+    .split(",")
+    .map((s) => s.trim().replace(/\/+$/, ""))
+    .filter(Boolean);
+}
+
+/** Origins the Android app (Capacitor) and local development use. Always allowed. */
+export const BUILT_IN_ORIGINS = [
+  "https://localhost",
+  "http://localhost",
+  "capacitor://localhost",
+  "http://localhost:5173",
+  "http://127.0.0.1:5173",
+];
+
+export function originAllowed(origin: string | undefined, allowed: string[]): boolean {
+  return !!origin && [...BUILT_IN_ORIGINS, ...allowed].includes(origin);
+}
+
+/** App links that bring the person back INTO the Android app (see src/lib/auth-redirect.ts). */
+export const NATIVE_REDIRECTS = ["sabzone://auth-callback", "sabzone://reset-password"];
+
+/**
+ * A link in an emailed message may only point at our own site or app. Without this, anyone could
+ * ask for a reset email whose button leads to a look-alike page.
+ */
+export function redirectAllowed(url: unknown, allowedOrigins: string[]): url is string {
+  if (typeof url !== "string" || url.length > 300) return false;
+  if (NATIVE_REDIRECTS.includes(url)) return true;
+  let u: URL;
+  try {
+    u = new URL(url);
+  } catch {
+    return false;
+  }
+  if (u.username || u.password) return false;
+  if (u.protocol !== "https:" && !(u.protocol === "http:" && u.hostname === "localhost"))
+    return false;
+  return allowedOrigins.includes(u.origin);
+}
+
+/** HMAC-SHA256 of `${label}:${value}`, shortened. Keeps raw IPs, emails and usernames out of the database. */
+export async function keyHash(secret: string, label: string, value: string): Promise<string> {
+  const enc = new TextEncoder();
+  const key = await crypto.subtle.importKey(
+    "raw",
+    enc.encode(secret),
+    { name: "HMAC", hash: "SHA-256" },
+    false,
+    ["sign"],
+  );
+  const sig = new Uint8Array(
+    await crypto.subtle.sign("HMAC", key, enc.encode(`${label}:${value}`)),
+  );
+  return Array.from(sig.slice(0, 16), (b) => b.toString(16).padStart(2, "0")).join("");
+}
diff --git a/supabase/manual/auth_lockdown.sql b/supabase/manual/auth_lockdown.sql
new file mode 100644
index 0000000..52aaa86
--- /dev/null
+++ b/supabase/manual/auth_lockdown.sql
@@ -0,0 +1,49 @@
+-- =====================================================================
+-- LOCK-DOWN: stop the browser from looking up people's emails.      *** RUN THIS LAST ***
+--
+-- Why: today anyone holding the public key can call these functions without logging in:
+--     get_login_email(username)   -> returns that person's real email address
+--     get_reset_emails(text)      -> returns email addresses for a username or an email
+--     get_login_emails(email)     -> returns every account address behind a mailbox
+--     plan_signup_email(email, u) -> reveals whether an email already has accounts
+--     is_username_available(u)    -> unlimited username probing
+-- After this script only the Edge Function (service role) can call them.
+--
+-- Order (see docs/AUTH-SECURITY.md):
+--   1. run supabase/migrations/20261116000000_auth_gateway.sql
+--   2. deploy the auth-gateway Edge Function and set its secrets
+--   3. ship the new web app and Android app, and wait until people have updated
+--   4. run THIS file.
+-- Older app versions call these functions directly, so they stop being able to log in or sign up
+-- the moment this script runs. This file is deliberately NOT in supabase/migrations/, so
+-- `supabase db push` never runs it by accident.
+--
+-- Safe to run more than once. To undo, run the grants at the bottom.
+-- =====================================================================
+
+do $$
+begin
+  if to_regprocedure('public.auth_gw_rate_hit(text, integer, integer)') is null then
+    raise exception 'Run supabase/migrations/20261116000000_auth_gateway.sql first.';
+  end if;
+end $$;
+
+revoke all on function public.get_login_email(text)         from public, anon, authenticated;
+revoke all on function public.get_login_emails(text)        from public, anon, authenticated;
+revoke all on function public.get_reset_emails(text)        from public, anon, authenticated;
+revoke all on function public.plan_signup_email(text, text) from public, anon, authenticated;
+revoke all on function public.is_username_available(text)   from public, anon, authenticated;
+
+grant execute on function public.get_login_email(text)         to service_role;
+grant execute on function public.get_login_emails(text)        to service_role;
+grant execute on function public.get_reset_emails(text)        to service_role;
+grant execute on function public.plan_signup_email(text, text) to service_role;
+grant execute on function public.is_username_available(text)   to service_role;
+
+-- ---------------------------------------------------------------------------------------------
+-- UNDO (only if you must roll back to the old app behaviour):
+--   grant execute on function public.get_login_email(text)         to anon, authenticated;
+--   grant execute on function public.get_login_emails(text)        to anon, authenticated;
+--   grant execute on function public.get_reset_emails(text)        to anon, authenticated;
+--   grant execute on function public.plan_signup_email(text, text) to anon, authenticated;
+--   grant execute on function public.is_username_available(text)  to anon, authenticated;
diff --git a/supabase/migrations/20261116000000_auth_gateway.sql b/supabase/migrations/20261116000000_auth_gateway.sql
new file mode 100644
index 0000000..4800ac9
--- /dev/null
+++ b/supabase/migrations/20261116000000_auth_gateway.sql
@@ -0,0 +1,181 @@
+-- =====================================================================
+-- Auth gateway support: rate-limit counters and brute-force lockouts.
+-- Used by the `auth-gateway` Edge Function (supabase/functions/auth-gateway).
+--
+-- ADDITIVE ONLY. Nothing here changes how the app works today:
+--   * new tables in the private schema (not exposed through the API),
+--   * new functions that only the service role (the Edge Function) can call,
+--   * the service role is explicitly allowed to call the existing sign-in helper functions.
+-- Run in Supabase Dashboard -> SQL Editor (or `supabase db push`). Safe to run more than once.
+--
+-- The lock-down step that stops the browser calling the old helper functions lives in
+-- supabase/manual/auth_lockdown.sql. Run it LAST, after the gateway is deployed and the new app
+-- version is out (see docs/AUTH-SECURITY.md).
+--
+-- Keys are HMAC hashes made by the Edge Function, so no raw IP address, email or username is
+-- stored here.
+-- =====================================================================
+
+create schema if not exists private;
+
+-- ------------------------------------------------ fixed-window request counters
+create table if not exists private.auth_rate_limits (
+  key          text primary key check (char_length(key) <= 160),
+  window_start timestamptz not null default now(),
+  hits         integer     not null default 0
+);
+alter table private.auth_rate_limits enable row level security;
+revoke all on private.auth_rate_limits from public, anon, authenticated;
+
+-- ------------------------------------------------ failed-attempt counters with lockout
+create table if not exists private.auth_lockouts (
+  key          text primary key check (char_length(key) <= 160),
+  fails        integer     not null default 0,
+  first_fail   timestamptz not null default now(),
+  locked_until timestamptz,
+  updated_at   timestamptz not null default now()
+);
+alter table private.auth_lockouts enable row level security;
+revoke all on private.auth_lockouts from public, anon, authenticated;
+
+-- Count one request for `p_key`. Returns allowed=false (and how many seconds to wait) once more
+-- than `p_limit` requests arrive within `p_window_seconds`. The check and the count are one
+-- atomic statement, so parallel requests cannot slip past the limit.
+create or replace function public.auth_gw_rate_hit(p_key text, p_limit integer, p_window_seconds integer)
+returns table (allowed boolean, retry_after integer)
+language plpgsql
+security definer
+set search_path = public, private, pg_temp
+as $$
+declare
+  v_start timestamptz;
+  v_hits  integer;
+begin
+  if p_key is null or char_length(p_key) not between 1 and 160
+     or p_limit is null or p_limit < 1
+     or p_window_seconds is null or p_window_seconds not between 1 and 86400 then
+    raise exception 'invalid rate limit arguments';
+  end if;
+
+  insert into private.auth_rate_limits as r (key, window_start, hits)
+  values (p_key, now(), 1)
+  on conflict (key) do update
+    set window_start = case when r.window_start <= now() - make_interval(secs => p_window_seconds)
+                            then now() else r.window_start end,
+        hits         = case when r.window_start <= now() - make_interval(secs => p_window_seconds)
+                            then 1 else r.hits + 1 end
+  returning r.window_start, r.hits into v_start, v_hits;
+
+  allowed := v_hits <= p_limit;
+  retry_after := case when allowed then 0
+                      else greatest(1, ceil(extract(epoch from
+                             (v_start + make_interval(secs => p_window_seconds) - now())))::integer) end;
+  return next;
+end $$;
+
+-- Is this key locked right now?
+create or replace function public.auth_gw_lock_status(p_key text)
+returns table (locked boolean, retry_after integer)
+language plpgsql
+stable
+security definer
+set search_path = public, private, pg_temp
+as $$
+declare v_until timestamptz;
+begin
+  select l.locked_until into v_until from private.auth_lockouts l where l.key = p_key;
+  locked := v_until is not null and v_until > now();
+  retry_after := case when locked then greatest(1, ceil(extract(epoch from (v_until - now())))::integer) else 0 end;
+  return next;
+end $$;
+
+-- Record one failed attempt. After `p_threshold` failures inside `p_window_seconds` the key is
+-- locked for p_base_seconds, doubling with every further failure up to p_max_seconds.
+create or replace function public.auth_gw_lock_fail(
+  p_key text, p_threshold integer, p_base_seconds integer, p_max_seconds integer, p_window_seconds integer)
+returns table (locked boolean, retry_after integer)
+language plpgsql
+security definer
+set search_path = public, private, pg_temp
+as $$
+declare
+  v_fails integer;
+  v_secs  integer;
+  v_until timestamptz;
+begin
+  if p_key is null or char_length(p_key) not between 1 and 160
+     or p_threshold is null or p_threshold < 1
+     or p_base_seconds is null or p_base_seconds < 1
+     or p_max_seconds is null or p_max_seconds < p_base_seconds
+     or p_window_seconds is null or p_window_seconds not between 1 and 86400 then
+    raise exception 'invalid lockout arguments';
+  end if;
+
+  insert into private.auth_lockouts as l (key, fails, first_fail, updated_at)
+  values (p_key, 1, now(), now())
+  on conflict (key) do update
+    set fails      = case when l.first_fail <= now() - make_interval(secs => p_window_seconds)
+                          then 1 else l.fails + 1 end,
+        first_fail = case when l.first_fail <= now() - make_interval(secs => p_window_seconds)
+                          then now() else l.first_fail end,
+        updated_at = now()
+  returning l.fails into v_fails;
+
+  if v_fails >= p_threshold then
+    v_secs := least(p_max_seconds::numeric, p_base_seconds * power(2, least(v_fails - p_threshold, 20)))::integer;
+    v_until := now() + make_interval(secs => v_secs);
+    update private.auth_lockouts set locked_until = v_until where key = p_key;
+    locked := true;
+    retry_after := v_secs;
+  else
+    locked := false;
+    retry_after := 0;
+  end if;
+  return next;
+end $$;
+
+-- A good attempt clears the failures.
+create or replace function public.auth_gw_lock_clear(p_key text)
+returns void
+language sql
+security definer
+set search_path = public, private, pg_temp
+as $$ delete from private.auth_lockouts where key = p_key $$;
+
+-- Housekeeping. Not scheduled by this migration; run it by hand now and then, or schedule it
+-- with pg_cron if you use it:  select public.auth_gw_cleanup();
+create or replace function public.auth_gw_cleanup()
+returns integer
+language plpgsql
+security definer
+set search_path = public, private, pg_temp
+as $$
+declare a integer; b integer;
+begin
+  delete from private.auth_rate_limits where window_start < now() - interval '1 day';
+  get diagnostics a = row_count;
+  delete from private.auth_lockouts
+   where updated_at < now() - interval '1 day' and (locked_until is null or locked_until < now());
+  get diagnostics b = row_count;
+  return a + b;
+end $$;
+
+-- Only the service role (the Edge Function) may call these.
+revoke all on function public.auth_gw_rate_hit(text, integer, integer)               from public, anon, authenticated;
+revoke all on function public.auth_gw_lock_status(text)                              from public, anon, authenticated;
+revoke all on function public.auth_gw_lock_fail(text, integer, integer, integer, integer) from public, anon, authenticated;
+revoke all on function public.auth_gw_lock_clear(text)                               from public, anon, authenticated;
+revoke all on function public.auth_gw_cleanup()                                      from public, anon, authenticated;
+grant execute on function public.auth_gw_rate_hit(text, integer, integer)               to service_role;
+grant execute on function public.auth_gw_lock_status(text)                              to service_role;
+grant execute on function public.auth_gw_lock_fail(text, integer, integer, integer, integer) to service_role;
+grant execute on function public.auth_gw_lock_clear(text)                               to service_role;
+grant execute on function public.auth_gw_cleanup()                                      to service_role;
+grant usage on schema private to service_role;
+
+-- The gateway looks accounts up with the existing helper functions. Make sure the service role may
+-- keep calling them once the browser no longer can (see supabase/manual/auth_lockdown.sql).
+grant execute on function public.get_login_email(text)           to service_role;
+grant execute on function public.get_reset_emails(text)          to service_role;
+grant execute on function public.plan_signup_email(text, text)   to service_role;
+grant execute on function public.is_username_available(text)     to service_role;
diff --git a/supabase/tests/replay/auth_gateway.assert.sql b/supabase/tests/replay/auth_gateway.assert.sql
new file mode 100644
index 0000000..3a176dd
--- /dev/null
+++ b/supabase/tests/replay/auth_gateway.assert.sql
@@ -0,0 +1,96 @@
+-- Tests for 20261116000000_auth_gateway.sql: counters, lockouts, and who may call what.
+-- Runs after every migration has been replayed (see run.sh). Any failing ASSERT fails the run.
+
+do $$
+declare r record; i integer;
+begin
+  -- ---------------------------------------------------------- fixed-window rate limit
+  for i in 1..3 loop
+    select * into r from public.auth_gw_rate_hit('t:rl', 3, 60);
+    assert r.allowed and r.retry_after = 0, format('hit %s should be allowed', i);
+  end loop;
+  select * into r from public.auth_gw_rate_hit('t:rl', 3, 60);
+  assert not r.allowed, '4th hit must be refused';
+  assert r.retry_after between 1 and 60, 'retry_after must be within the window: ' || r.retry_after;
+
+  select * into r from public.auth_gw_rate_hit('t:other', 3, 60);
+  assert r.allowed, 'another key is not affected';
+
+  -- the window rolls over
+  update private.auth_rate_limits set window_start = now() - interval '2 minutes' where key = 't:rl';
+  select * into r from public.auth_gw_rate_hit('t:rl', 3, 60);
+  assert r.allowed, 'a new window starts after it expires';
+  assert (select hits from private.auth_rate_limits where key = 't:rl') = 1, 'counter restarts at 1';
+
+  -- ---------------------------------------------------------- lockout with doubling
+  select * into r from public.auth_gw_lock_status('t:lock');
+  assert not r.locked, 'unknown key is not locked';
+
+  for i in 1..4 loop
+    select * into r from public.auth_gw_lock_fail('t:lock', 5, 30, 200, 900);
+    assert not r.locked, format('failure %s of 5 must not lock yet', i);
+  end loop;
+  select * into r from public.auth_gw_lock_fail('t:lock', 5, 30, 200, 900);
+  assert r.locked and r.retry_after = 30, 'threshold reached: locked for the base time, got ' || r.retry_after;
+  select * into r from public.auth_gw_lock_status('t:lock');
+  assert r.locked and r.retry_after between 1 and 30, 'status shows the lock';
+
+  select * into r from public.auth_gw_lock_fail('t:lock', 5, 30, 200, 900);
+  assert r.retry_after = 60, 'next failure doubles the lock: ' || r.retry_after;
+  select * into r from public.auth_gw_lock_fail('t:lock', 5, 30, 200, 900);
+  assert r.retry_after = 120, 'doubles again: ' || r.retry_after;
+  select * into r from public.auth_gw_lock_fail('t:lock', 5, 30, 200, 900);
+  assert r.retry_after = 200, 'capped at the maximum: ' || r.retry_after;
+
+  perform public.auth_gw_lock_clear('t:lock');
+  select * into r from public.auth_gw_lock_status('t:lock');
+  assert not r.locked, 'a good attempt clears the lock';
+
+  -- old failures fall out of the window
+  for i in 1..4 loop perform public.auth_gw_lock_fail('t:win', 5, 30, 200, 900); end loop;
+  update private.auth_lockouts set first_fail = now() - interval '1 hour' where key = 't:win';
+  select * into r from public.auth_gw_lock_fail('t:win', 5, 30, 200, 900);
+  assert not r.locked and (select fails from private.auth_lockouts where key = 't:win') = 1,
+    'failures older than the window are forgotten';
+
+  -- ---------------------------------------------------------- bad arguments are refused
+  begin perform public.auth_gw_rate_hit('', 3, 60); assert false, 'empty key accepted';
+  exception when raise_exception then null; end;
+  begin perform public.auth_gw_rate_hit('k', 0, 60); assert false, 'limit 0 accepted';
+  exception when raise_exception then null; end;
+  begin perform public.auth_gw_rate_hit('k', 3, 999999); assert false, 'huge window accepted';
+  exception when raise_exception then null; end;
+  begin perform public.auth_gw_lock_fail('k', 5, 100, 50, 900); assert false, 'max below base accepted';
+  exception when raise_exception then null; end;
+
+  -- ---------------------------------------------------------- housekeeping
+  update private.auth_rate_limits set window_start = now() - interval '3 days' where key = 't:other';
+  assert public.auth_gw_cleanup() >= 1, 'cleanup removes stale rows';
+  assert not exists (select 1 from private.auth_rate_limits where key = 't:other'), 'stale counter gone';
+end $$;
+
+-- ------------------------------------------------------------ who may call what
+do $$
+declare fn text; role_name text;
+begin
+  foreach role_name in array array['anon', 'authenticated'] loop
+    foreach fn in array array[
+      'public.auth_gw_rate_hit(text, integer, integer)',
+      'public.auth_gw_lock_status(text)',
+      'public.auth_gw_lock_fail(text, integer, integer, integer, integer)',
+      'public.auth_gw_lock_clear(text)',
+      'public.auth_gw_cleanup()'] loop
+      assert not has_function_privilege(role_name, fn, 'execute'), role_name || ' must not run ' || fn;
+      assert has_function_privilege('service_role', fn, 'execute'), 'service_role must run ' || fn;
+    end loop;
+    assert not has_table_privilege(role_name, 'private.auth_rate_limits', 'select'), role_name || ' reads counters';
+    assert not has_table_privilege(role_name, 'private.auth_lockouts', 'select'), role_name || ' reads lockouts';
+  end loop;
+
+  -- the gateway must keep access to the sign-in helpers after the lock-down
+  foreach fn in array array[
+    'public.get_login_email(text)', 'public.get_reset_emails(text)',
+    'public.plan_signup_email(text, text)', 'public.is_username_available(text)'] loop
+    assert has_function_privilege('service_role', fn, 'execute'), 'service_role must run ' || fn;
+  end loop;
+end $$;
diff --git a/supabase/tests/replay/auth_lockdown.afterlockdown.sql b/supabase/tests/replay/auth_lockdown.afterlockdown.sql
new file mode 100644
index 0000000..89aed2b
--- /dev/null
+++ b/supabase/tests/replay/auth_lockdown.afterlockdown.sql
@@ -0,0 +1,37 @@
+-- Runs AFTER supabase/manual/auth_lockdown.sql has been applied (see run.sh).
+do $$
+declare fn text; role_name text; v_id uuid := gen_random_uuid();
+begin
+  foreach role_name in array array['anon', 'authenticated'] loop
+    foreach fn in array array[
+      'public.get_login_email(text)', 'public.get_login_emails(text)', 'public.get_reset_emails(text)',
+      'public.plan_signup_email(text, text)', 'public.is_username_available(text)'] loop
+      assert not has_function_privilege(role_name, fn, 'execute'),
+        role_name || ' can still call ' || fn || ' after the lock-down';
+    end loop;
+  end loop;
+
+  foreach fn in array array[
+    'public.get_login_email(text)', 'public.get_login_emails(text)', 'public.get_reset_emails(text)',
+    'public.plan_signup_email(text, text)', 'public.is_username_available(text)'] loop
+    assert has_function_privilege('service_role', fn, 'execute'), 'service_role lost ' || fn;
+  end loop;
+
+  -- and the functions still work for the service role
+  insert into auth.users (id, email, raw_user_meta_data)
+  values (v_id, 'lock.test@example.com', jsonb_build_object('username', 'lock_test', 'full_name', 'Lock Test'));
+  set local role service_role;
+  assert public.get_login_email('lock_test') = 'lock.test@example.com', 'service role can still resolve a username';
+  assert public.is_username_available('lock_test') = false, 'taken username is reported';
+  assert public.is_username_available('free_name_1') = true, 'free username is reported';
+  reset role;
+
+  -- a real client (anon) is refused outright
+  set local role anon;
+  begin
+    perform public.get_login_email('lock_test');
+    assert false, 'anon could still read an email';
+  exception when insufficient_privilege then null;
+  end;
+  reset role;
+end $$;
diff --git a/supabase/tests/replay/run.sh b/supabase/tests/replay/run.sh
index 6e67d87..66c2361 100644
--- a/supabase/tests/replay/run.sh
+++ b/supabase/tests/replay/run.sh
@@ -32,5 +32,24 @@ for t in "$HERE"/*.assert.sql; do
     echo "FAIL  $(basename "$t")"; echo "$out" | head -10 | sed 's/^/        /'; status=1
   fi
 done
+# Lock-down script (kept outside migrations on purpose), then the checks that need it applied.
+LOCKDOWN="$HERE/../../manual/auth_lockdown.sql"
+if [ -f "$LOCKDOWN" ]; then
+  for pass in 1 2; do   # run twice: it must be safe to repeat
+    if out=$(psql -q -d "$DB" -v ON_ERROR_STOP=1 -f "$LOCKDOWN" 2>&1 >/dev/null | grep -v -E "NOTICE|WARNING|HINT"); [ -z "$out" ]; then
+      echo "ok    manual/auth_lockdown.sql (run $pass)"
+    else
+      echo "FAIL  manual/auth_lockdown.sql"; echo "$out" | head -8 | sed 's/^/        /'; status=1
+    fi
+  done
+  for t in "$HERE"/*.afterlockdown.sql; do
+    [ -f "$t" ] || continue
+    if out=$(psql -q -d "$DB" -v ON_ERROR_STOP=1 -f "$t" 2>&1 >/dev/null | grep -v -E "^(NOTICE|WARNING|HINT)|^psql:.*(NOTICE|WARNING)"); [ -z "$out" ]; then
+      echo "pass  $(basename "$t")"
+    else
+      echo "FAIL  $(basename "$t")"; echo "$out" | head -10 | sed 's/^/        /'; status=1
+    fi
+  done
+fi
 dropdb --if-exists "$DB" >/dev/null 2>&1
 exit $status
